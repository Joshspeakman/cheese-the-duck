 "lines": {"toy_sandbox_rake_tracks": ["Smooth again. No evidence.", "A clean sand floor. Very innocent."], "toy_sandbox_hammer_stud": ["Back down. You are welcome, wood.", "One stud. Lifelong enemy now."], "toy_sandbox_dig_pit": ["Down we go. Still no treasure. Typical.", "Dug it. Fell in it. In that order."], "toy_sandbox_sand_angel": ["Angel. Look at the wingspan on that.", "Lie in it, get up, regret nothing."], "toy_sandbox_stomp_heap_flat": ["Flattened. It had it coming.", "Heap: gone. Me: taller."], "toy_sandbox_fling_sand_at_wall": ["Take that, wall. And that.", "Sand: airborne. Wall: unmoved. Draw."], "toy_sandbox_honk_into_bucket": ["Sounds like a bigger me.", "Bucket has better acoustics than the barn."], "toy_sandbox_taste_sand": ["Tastes like the floor. Because it is the floor.", "Sand. Still sand. Zero stars."], "toy_sandbox_nap_in_the_sand": ["Perfect fit. Of course it is. I wore it in.", "Do not tell the shovel I slept here."], "toy_sandbox_sit_on_the_board_edge": ["Sun goes down. I stay sat. Efficient.", "Best seat. Cost me nothing."], "toy_sandbox_sulk_at_the_far_wall": ["Not sulking. Facing the wall. Different.", "Sand did this to me."], "toy_sandbox_dust_bath_in_the_sand": ["Clean now. Dirtier. Same thing.", "Dust bath. Filthy, correct, dignified."], "toy_sandbox_king_of_the_heap": ["King of this exact pile. Bow or leave.", "Long live me. Short pile."], "toy_sandbox_sign_the_sand": ["Cheese was here. Cheese is always here.", "Signed it. Let the wind try to forge it."], "toy_sandbox_drum_the_bucket": ["Thank you. Tip the bucket.", "Encore? No. I have standards."], "toy_sandbox_head_wedged_in_bucket": ["Wedged by the shoulders. Bucket won.", "I meant to do that. All of it."], "toy_sandbox_trip_on_the_board": ["Face. Sand. Dignity: buried.", "The board moved. It is always the board."], "toy_sandbox_bonk_the_shovel_shaft": ["Saw the shaft coming. Chose violence anyway.", "Shaft: unharmed. Skull: negotiating."], "toy_sandbox_cave_in_the_heap": ["I dug. It fell. Physics is a snitch.", "Buried by my own heap. Good work, me."], "toy_sandbox_blow_sand_back_in_his_face": ["Blew it away. It came back. Rude.", "Wind: one. Eyes: nil."]},
