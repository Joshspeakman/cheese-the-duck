 "lines": {"toy_sandbox_dig_pit": ["Down we go. Still no treasure. Typical.", "Hole. Mine. Keep your feet out of it."], "toy_sandbox_sand_angel": ["Angel. Obviously. Look at the span.", "Lie in it, get up, regret nothing."], "toy_sandbox_mound_stomp": ["Flattened. It had it coming.", "Heap: gone. Me: taller."], "toy_sandbox_sand_fling": ["Take that, wall. And that.", "Sand: airborne. Wall: unmoved. Draw."], "toy_sandbox_bucket_megaphone": ["Sounds like a bigger me.", "HONK. It's got a better echo than the barn."], "toy_sandbox_taste_sand": ["Tastes like the floor. Because it is the floor.", "Sand. Still sand. Zero stars."], "toy_sandbox_knock_walls": ["Hollow on one side. Suspicious.", "It's just wood. Disappointing wood."], "toy_sandbox_nap_in_hollow": ["Perfect fit. Of course it is. I dug it.", "Do not tell the shovel I slept in its hole."], "toy_sandbox_sulk_in_corner": ["I'm not sulking. I'm facing the wall. Different.", "Leave me. I'm busy being betrayed by sand."], "toy_sandbox_perch_shovel_grip": ["Lookout. Nothing has happened. Perfect shift.", "Eyes shut, ears open. Mostly shut."], "toy_sandbox_dust_bath": ["Clean now. Dirtier. Same thing.", "Dust bath. Filthy, correct, dignified."], "toy_sandbox_king_of_the_heap": ["King of this exact pile. Bow or leave.", "Long live me. Short pile."], "toy_sandbox_sign_the_sand": ["Cheese was here. Cheese is always here.", "Signed it. Let the wind try to forge it."], "toy_sandbox_drumroll_bucket": ["Thank you. Tip the bucket.", "Encore? No. I have standards."], "toy_sandbox_wedged_in_bucket": ["Wedged by the shoulders. Bucket: won.", "I meant to do that. All of it."], "toy_sandbox_trip_on_board": ["Face. Sand. Dignity: buried.", "The board moved. It's always the board."], "toy_sandbox_shovel_whack": ["OW. Shit. Okay. Zero stars, would touch again.", "Handle to the face. Fair. I started it."], "toy_sandbox_cave_in": ["I dug. It fell. Physics is a snitch.", "Buried by my own heap. Good work, me."]},
