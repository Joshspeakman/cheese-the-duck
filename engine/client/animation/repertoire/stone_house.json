 "lines": {"stone_house_scrub_the_left_stones": ["Scrubbed it. Stone looks smug. Stone always does.", "Wing sore. Wall clean. Bargain."], "stone_house_press_mortar_back": ["Seam sealed. House holds. Nobody thanks the duck.", "Mortar mortared. Poetry in grit."], "stone_house_preen_in_the_polish": ["Handsome duck. Bent in the middle. Still handsome.", "Plate shows me my best side. All of it."], "stone_house_knock_the_lower_plate": ["Stone house. Wood door. Wooden silence.", "Knocked. Echo answered. Echo is rude."], "stone_house_lean_into_the_big_door": ["Door won. It is oak. I am a duck.", "Shoulder sore. Door fresh. Oak has stamina."], "stone_house_holler_up_at_the_lantern": ["Lantern does not answer. Lantern is the strong silent type.", "Shouted at a light. Light stayed on. Smug."], "stone_house_haul_the_upper_plate": ["Plate went clunk. House heard. House stayed put.", "Pulled the door plate. Nothing opened. Typical stone."], "stone_house_sniff_the_stone_flecks": ["Moss, damp, and someone's lunch. Good house.", "Sniffed the wall. It smelled back. Intense."], "stone_house_flatten_at_the_right_wing": ["Quack. House shrugged. House is stone.", "Leapt out. The wing did not flinch. Wing is stone."], "stone_house_rap_the_stone_for_a_ring": ["Solid. Dead solid. Like the conversation.", "Rapped every stone. All of them said no."], "stone_house_measure_the_sill_against_himself": ["Sill wins by a head. Mine.", "Higher than me. Measured. Resentful."], "stone_house_lick_a_pale_fleck": ["Not salt. Not sugar. Stone. Noted.", "Tastes like a cold floor. Walls are surprisingly floors."], "stone_house_lean_against_the_warm_wall": ["Warm stone. Slow thoughts. Excellent trade.", "The wall kept the sun for me. Kind wall."], "stone_house_sit_on_the_stone_step": ["Doing nothing. Stone house approves. Stone house always approves.", "Sat. Counted pebbles. Lost count at one."], "stone_house_sulk_at_the_foundation": ["House ignored me first. Sulk is retaliation.", "Cold stone. Colder duck. Stubbornness is insulation."], "stone_house_scrape_frost_off_the_step": ["Frost off the step. Duck's bill: blunt. Worth it.", "Scraped it clean. Feet are still cold. Dignity: also cold."], "stone_house_rake_the_fallen_leaves": ["Leaves raked. Sky has plenty more. Sky is not sorry.", "Heap built. Wind plans a rematch."], "stone_house_listen_for_the_drip": ["Plip. Plip. Plip. Drum solo, stone-house edition.", "Eaves drip. I judge their timing."], "stone_house_skate_off_the_icy_step": ["Ice. Stone. Duck. Order of arrival: wrong.", "Slipped like I meant it. I did not mean it."], "stone_house_walk_into_the_door_foot": ["Door was shut. Door is always shut. Rude.", "Bill first. Brain second. Order unchanged."], "stone_house_crack_a_mortar_line": ["Seam went. House will cope. House has options.", "Too hard. Stone remembers. Stone files grievances."], "stone_house_bill_jammed_at_the_plate": ["Plate ate my bill. Gave it back, bent.", "Bill jammed. Dignity jammed harder."], "stone_house_stub_a_toe_on_the_lip": ["Lip was fine. Toe was not. Lip gloated.", "Stone is hard. Noted. Ow."], "stone_house_pose_beside_the_lantern": ["Lord of the manor. Do not ask which manor.", "Posed under a lantern. Gentry lighting."], "stone_house_present_the_house": ["Solid. Historic. Priced to ignore.", "Two wings, one duck. Cosy for ducks."], "stone_house_argue_with_the_door": ["Door says nothing. Wins by default. Cheat.", "Last word is mine. Door has the last everything else."]},
