 "lines": {"stone_house_scrape_moss_off_the_stones": ["Moss off the stone. Moss will be back. Moss is committed.", "Scraped it green. Stone looks naked."], "stone_house_set_a_loose_stone_back": ["Stone back in its row. House stands. I fall over.", "Shoved it into place. Stone saw it coming."], "stone_house_push_the_oak_door": ["Heavy door. Heavier opinion of me.", "Shoulder met oak. Oak is winning."], "stone_house_shout_up_the_chimney": ["Shouted at the chimney. It coughed soot. Rude.", "Echo came back as smoke. Smoke has no manners."], "stone_house_drum_on_the_stones": ["Stone has no rhythm. Wonderful bass.", "Stone on the downbeat. Moss on the hi-hat."], "stone_house_test_the_stone_for_cold": ["Cold. Stone is cold. Report filed.", "Cheek cold. Opinion colder."], "stone_house_prod_the_lantern": ["Lantern did not swing. Lantern is bolted. Lantern is loyal.", "Poked it. It glowered. Lanterns do that."], "stone_house_lean_on_the_sunny_stone": ["Warm stone. This is why they built houses of it.", "Heat in the rock, none in my plans."], "stone_house_sulk_at_the_chimney_side": ["The house knows what it did.", "Sulking in stone's shadow. Roomy."], "stone_house_chip_frost_off_the_foot_strip": ["Frost chipped off. Step smug about its shine.", "Foot strip free. Beak slightly less so."], "stone_house_kick_the_drift_off_the_slab": ["Slab clear. Foot frozen. Net gain: slab.", "Snow flew. I did not."], "stone_house_shelter_in_the_door_recess": ["Slate sheds, I shelter, the weather loses.", "Dry doorway. Wet yard. Great seats."], "stone_house_slip_on_the_icy_step": ["Ice has a sense of humour. Stone has none.", "Feet north, duck south, step unmoved."], "stone_house_walk_into_the_oak_door": ["Solid oak. Solid regret.", "Door was closed. I was optimistic."], "stone_house_kick_a_stone_by_accident": ["Stone: 1. Toe: 0. Stone barely noticed.", "Kicked the house. House kicked back, slowly."], "stone_house_show_off_the_stone_house": ["Solid. Draughty. Built to outlive the buyer.", "Chimney included. Duck optional."], "stone_house_tug_a_rope_of_moss": ["Moss came off in one long green sigh.", "Held up the moss. Stone looked bald."]},
