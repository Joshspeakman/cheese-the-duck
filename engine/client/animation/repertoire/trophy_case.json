 "lines": {"trophy_case_wipe_the_breath_mist_off": ["Clear. Now the stands can watch me back.", "Mist gone. So is the evidence."], "trophy_case_scrub_the_toe_scuffs_off_the_rail": ["Scrubbed my own footprints off. Looks like a clean getaway.", "Rail's clean. The next scuff is on someone else."], "trophy_case_polish_the_end_studs": ["Brass again. I can see my own chin in it.", "Two studs gleaming. The rest of the case can catch up."], "trophy_case_huff_a_fog_onto_the_glass": ["Fogged it. Weather, but mine.", "Breath on glass. I am basically a cloud."], "trophy_case_peck_a_rude_word_into_the_fog": ["Wrote what I think of the stands. Smudged the worst bit.", "A word of three letters. It was 'arse'."], "trophy_case_knock_twice_on_the_door_seam": ["Knocked twice. The case is out. Or ignoring me.", "No one home but a trophy stand."], "trophy_case_hook_a_wing_in_the_seam_and_heave": ["Locked. Of course it is. Who locks a duck out?", "Heaved till my wing creaked. The doors won."], "trophy_case_tap_each_stand_with_a_twig": ["Tink, tonk, tink. Solid wood, all three. Disappointing.", "Tapped the stands like a doctor. They're all fine."], "trophy_case_drum_along_the_slats": ["Slats make a rubbish drum. I'm in a band now.", "Rat-a-tat. The case has rhythm, who knew."], "trophy_case_race_the_length_of_the_rail": ["Rail to rail in no time. I win. Not one timer present.", "Fastest duck on this rail. Only duck on this rail."], "trophy_case_lick_the_bottom_rail": ["Cold. Tastes of nothing. Expensive nothing.", "Not brass. I'd know. I've licked worse."], "trophy_case_ear_against_the_slats": ["Wood. Quiet wood. Might be the case sulking.", "Heard my own pulse. Wrong thing, still alive."], "trophy_case_doze_off_with_his_bill_on_the_rail": ["Rail makes a decent pillow. Cold, but decent.", "Out like a light. A very small light."], "trophy_case_sulk_with_his_back_to_the_slats": ["Back to the case. It knows what it did.", "Sulking at furniture. Peak form."], "trophy_case_lean_a_shoulder_on_the_end_stud": ["Leaned for a bit. The stud held. Teamwork.", "Sighed at the doors. They did not sigh back."], "trophy_case_fluff_up_at_his_own_reflection": ["Handsome. The glass agrees, which is all I ask of glass.", "One cheek, other cheek. Done. Devastating."], "trophy_case_warm_his_back_on_the_sunny_slats": ["Slats are warm. Back is warm. Mood: warm.", "Sun on the wood, wood on my back. Peak duck."], "trophy_case_bow_low_at_the_foot_of_the_case": ["Bowed to the case. It didn't clap. Rude.", "Low bow, high standards. Next time, flowers."], "trophy_case_argue_with_the_glass": ["You're a window with ideas. Sit down.", "Won the argument. Glass said nothing, as is its way."], "trophy_case_topple_over_craning_for_the_top": ["Looked up. Fell down. The case watched.", "Backwards. Elegant. No witnesses, I checked twice."], "trophy_case_boot_the_rail_and_hop_about": ["Kicked a rail. The rail is fine. My foot isn't.", "Zero stars. Would kick again, harder."]},
