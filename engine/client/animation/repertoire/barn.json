 "lines": {"barn_scrub_boards": ["Barn was filthy. Now it is only my fault.", "Boards clean. Wing filthy. Fair trade."], "barn_hammer_stud": ["Stud flat. Barn holds. Send thanks in bread.", "Hammered it with my face. Worked."], "barn_comb_planter": ["Neat leaves. Barn looks almost loved.", "Combed a plant. Dignity: intact. Mostly."], "barn_knock_leaf": ["Barn said nothing. Rude. Also barns.", "Knocked twice. The cows can wait."], "barn_shoulder_leaf": ["Door won. I will be back. With a bigger shoulder.", "It did not budge. Neither did my pride."], "barn_hang_off_ring": ["Ring held. I am extremely heavy. Know it.", "Hung there. Barn took the weight. Ring took offence."], "barn_holler_for_farmer": ["Farmer is out. Barn is mine. Good arrangement.", "Nobody answered. I will call that approval."], "barn_flatten_at_jamb": ["Boo. Barn did not flinch. Damn.", "Jumped out. Jamb unmoved. Tough crowd."], "barn_drum_right_boards": ["Barn has a good beat. Poor tempo discipline.", "Planks on the downbeat. Studs on the off."], "barn_measure_against_jamb": ["Door is tall. I am a duck. Nobody lied.", "Reached the middle of the jamb. Statistically fine."], "barn_lean_warm_boards": ["Warm boards. This is the correct use of a barn.", "Sun in the planks. Heat in my shoulder. Peace."], "barn_sit_on_step": ["Yard did nothing. Fantastic yard.", "Sat. Looked. Left with my opinions intact."], "barn_sulk_at_leaf": ["Not looking at you. Door. Barn. Whoever.", "Sulking is a full-time job. Pays nothing."], "barn_scrape_frost_latch": ["Latch iced over. Chipped it free. Hero stuff.", "Frost off the latch. Cold in the nostrils."], "barn_kick_drift_off_step": ["Snow kicked. Step visible. Feet colder. Worth it.", "Drift gone. Dignity airborne."], "barn_skid_on_frost": ["Frost is a liar. A lying, white liar.", "Feet went north. Duck went south. Barn watched."], "barn_bill_frozen_to_ring": ["Ring tastes like regret. And iron. Mostly regret.", "Frozen to a door ring. Bill is not for kissing."], "barn_walk_into_the_leaf": ["Door was closed. Door has always been closed.", "Walked straight into it. It had a point."], "barn_peck_stud_too_hard": ["Cracked it. Barn will live. I am less sure.", "Hit it harder than the stud deserved."], "barn_pose_in_doorway": ["Farm owner. Do not ask what farm.", "Posed. Nobody photographed it. Their loss."], "barn_present_the_barn": ["Spacious. Lots of potential. No viewings.", "Two doors, one planter, zero offers."], "barn_argue_with_latch": ["Ring refuses to explain. Ring is a coward.", "Won the argument. Ring has not conceded."]},
