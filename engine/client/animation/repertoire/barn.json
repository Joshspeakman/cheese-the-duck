 "lines": {"barn_scrub_boards": ["Barn was filthy. Now it is only my fault.", "Boards clean. Wing filthy. Fair trade."], "barn_sweep_lip": ["Lip swept. Dust relocated to the yard.", "Door lip has never been this smug."], "barn_hammer_nail": ["Nail flat. Barn holds. Send thanks in bread.", "Hammered it with my face. Worked."], "barn_rake_hay": ["Hay back in the pile. Hay will be out again by noon.", "Raked it tidy. The pile looks suspicious."], "barn_shoulder_leaf": ["Left leaf. Zero give. Respect, I suppose.", "Shoulder hurts. Door unbothered."], "barn_knock_right_leaf": ["Knocked twice. Barn has the manners of a barn.", "Waited politely. Door waited rudely."], "barn_pull_hay_strand": ["Hay came out. So did a bit of the pile. Fine.", "Strand acquired. Strand dropped. Hay is everywhere."], "barn_shout_up_loft": ["Only the echo answers up there.", "Shouted at the hatch. Hatch shrugged."], "barn_climb_hay_slide": ["Top of the hay. King of nothing. Down again.", "Slid all the way down. Would slide again."], "barn_drum_right_boards": ["Barn has a good beat. Poor tempo discipline.", "Planks on the downbeat. Nails on the off."], "barn_dig_hay_hollow": ["Hole in the hay. Mine. Staying out of the plans.", "Dug it. The barn will want it back."], "barn_measure_up_the_post": ["Door is tall. I am a duck. No lies told.", "Reached the middle of the post. Statistically fine."], "barn_taste_a_hay_strand": ["Hay. Tastes like hay. I was hoping for a trick.", "Chewed it. Regret is mostly fibre."], "barn_lean_warm_boards": ["Warm boards. This is the correct use of a barn.", "Sun in the planks. Heat in my shoulder. Peace."], "barn_sit_on_the_step": ["Yard did nothing. Fantastic yard.", "Sat. Looked. Left with my opinions intact."], "barn_nap_on_the_hay": ["Hay nap. Straw in my ear. Zero complaints.", "Slept on the pile. Pile slept on me."], "barn_chip_frost_off_lip": ["Lip iced over. Chipped it free. Hero stuff.", "Frost off the lip. Cold in the nostrils."], "barn_kick_drift_off_step": ["Snow kicked. Step visible. Feet colder. Worth it.", "Drift gone. Dignity airborne."], "barn_skid_on_frosted_lip": ["Frost is a liar. A lying, white liar.", "Feet went north. Duck went south. Barn watched."], "barn_bill_wedged_in_seam": ["Seam bit back. Barn doors have a grudge.", "Bill freed. Pride still in the gap."], "barn_walk_into_the_leaf": ["Door was closed. Door has always been closed.", "Walked straight into it. It had a point."], "barn_present_the_barn": ["Spacious. Lots of potential. No viewings.", "Two doors, one hay stack, zero offers."]},
