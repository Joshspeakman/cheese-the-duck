 "lines": {"magpie_friendship_charm_clear_the_breath_off_the_pane_around_the_pendant": ["Cleared round the bird. It looked pleased. It's a pendant.", "Fog off. Beak showing. Magpie: unimpressed, forever."], "magpie_friendship_charm_hold_the_charm_out_eye_to_eye": ["Eye to eye. It blinked first. Pendants cheat.", "Said hello. It said nothing. Best conversation this week."], "magpie_friendship_charm_tap_the_pane_twice_and_wait_for_two_back": ["Two taps. Silence. Magpie's playing it cool.", "Waited. Got nothing. Still counts as a conversation."], "magpie_friendship_charm_ring_the_plate_like_a_doorbell_for_the_magpie": ["Rang. Nobody answered. Magpie's being rude. It's a pendant.", "Doorbell. Dignity. Wait. Nothing."], "magpie_friendship_charm_shuffle_the_hop_and_flap_along_the_slats": ["Magpie jig. Original steps. Self-taught. Broken ankle pending.", "The charm kept time. Rare quality in a pendant."], "magpie_friendship_charm_weigh_the_friendship_in_his_bill": ["Light. Friendship is light. Rent isn't.", "Weighed it. Mostly string. Mostly good."], "magpie_friendship_charm_nap_fluffed_up_like_a_magpie_in_a_nest": ["Fluffed. Nest-ish. Eyes: closed. Beak: open. Snoring.", "Guarded the charm for six minutes. Then rested my case."], "magpie_friendship_charm_sulk_because_the_magpie_has_not_called": ["Not counting. It's been exactly nine days.", "No call. No note. Fine. I have bread."], "magpie_friendship_charm_sit_side_by_side_with_the_pendant_saying_nothing": ["Said nothing. It said nothing back. Peak friendship.", "Comfortable silence. Mostly his. A little mine."], "magpie_friendship_charm_present_the_charm_to_the_whole_room_as_his_friend": ["Meet my friend. Don't mention the beak. It's sensitive.", "Introduced it round. Room: empty. Warm anyway."], "magpie_friendship_charm_argue_over_who_is_the_better_thief": ["Better thief. Stole a march on me. Fine. Draw.", "It never took my bread. Respect. Suspicion."], "magpie_friendship_charm_call_chak_chak_across_the_garden": ["Chak chak. Nothing. It's busy being famous.", "Called twice. Got a wind. Might count."], "magpie_friendship_charm_tilt_heads_in_unison_at_the_charm": ["Same tilt. Same face. Friend: far better at it.", "We looked like a pair of pendants. Not the pretty kind."], "magpie_friendship_charm_huff_a_patch_of_mist_and_peck_two_birds_in_it": ["Two birds. Side by side. One's me. Crooked.", "Drew a friend in fog. It'll be gone by noon. Like most."]},
