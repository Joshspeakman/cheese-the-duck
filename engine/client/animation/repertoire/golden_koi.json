 "lines": {"golden_koi_fish_the_leaves_off_the_golden_run": ["Clean run for the gold. Leaves had it coming.", "Fished out a whole autumn. It hasn't noticed."], "golden_koi_untangle_the_long_barbels_from_a_stem": ["Free. It looked at me like I owed it gold. Fair.", "One stem, two barbels, a lot of thanks left unspoken."], "golden_koi_tilt_a_wing_to_throw_the_light": ["Threw a sunbeam. It chased it. Me neither, so far.", "Gold fish, gold light. Redundant, shining."], "golden_koi_hold_a_flake_to_the_dawn_surface": ["Sipped from my bill. A nibble of royalty.", "Hand-fed a golden fish. Do not tell the others, they are plain."], "golden_koi_lead_it_through_the_blooms_with_a_wingtip": ["It looped a lily like it owned the lease.", "Led a gold fish about. Nobody had to bribe it."], "golden_koi_race_the_gold_along_the_pads": ["Lost to an ornament. Of course. It is gold.", "Beaten by a flake with fins. Pride in the bin."], "golden_koi_bow_to_the_rising_gold": ["Bowed to a fish with a halo. Totally earned.", "Kowtowed to a koi. It did not pay me. Rude."], "golden_koi_argue_over_which_of_them_shines": ["It shines on its own. I need a lamp. Unfair.", "Argued with a mirror that has fins. Lost to the mirror."], "golden_koi_sing_up_the_dawn_for_the_gold": ["Sang. It shimmered. We are collaborators.", "A note for the sun. The sun took its time."], "golden_koi_hop_back_from_the_gold_flash": ["It flashed. I flinched. It saw.", "Blinded by a fish. Mark it on the wall of shame."], "golden_koi_bounce_the_glint_between_two_wings": ["Bounced a sunbeam off a pal. Caught on the fish.", "Light, passed hand to hand. Fish took the receipt."], "golden_koi_count_the_gold_rings_in_turn": ["Odd for me, even for them, nobody for the koi.", "Seven rings. Eight if you are generous. I am not."]},
