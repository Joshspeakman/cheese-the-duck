 "lines": {"golden_acorn_huff_and_buff_the_cap": ["Gleam restored. I am a professional.", "Shinier than my future."], "golden_acorn_wipe_off_the_beak_prints": ["Prints gone. Evidence destroyed.", "Wiped it. Now it is only suspicious."], "golden_acorn_rub_out_a_scuff": ["Scuff gone. Not a mark on me. Or it.", "Mended with my chest. Professional chest."], "golden_acorn_tiptoe_it_to_a_safer_spot": ["Moved it. It is safer now. Probably.", "Tiptoed. A duck of rare delicacy."], "golden_acorn_stash_it_and_look_round": ["Stashed. Nobody saw. Probably a pigeon saw.", "Gold is secure. My nerves are not."], "golden_acorn_heave_it_a_hand_along": ["Heavy. Gold is heavy. So is regret.", "Moved it a hand's width. Sweating. Worth it."], "golden_acorn_roll_it_slow_and_fetch": ["Rolled it. Dirt got it. I am furious.", "Fetched it by the stalk. Very gentlemanly."], "golden_acorn_weigh_the_gold_in_the_bill": ["Heavier than bread. Barely.", "Weighed it. Judged it. Gold weighs gold."], "golden_acorn_tilt_it_to_catch_the_sun": ["Flash! Blind. Worth it.", "Made a small sun. Nobody asked for a sun."], "golden_acorn_race_a_lap_round_it": ["Lapped it. It did not try. Cheat.", "I win. It cannot even run."], "golden_acorn_bite_it_to_see_if_it_is_real": ["Hard. Real. My tooth: also hard. No teeth.", "It is real gold. I tested it with my face."], "golden_acorn_count_it_twice": ["One. Still one. Suspicious.", "Counted twice. Both ones. Money is simple."], "golden_acorn_stretch_my_face_in_the_gold": ["Long face. Accurate.", "In the gold I look expensive. Fine."], "golden_acorn_sit_on_it_like_an_egg": ["Hatching it. Nothing yet. Patience.", "It is warm from my bum. Do not tell."], "golden_acorn_watch_for_a_thief": ["Come on, pigeon. Try something.", "Nobody takes it. I have glared at worse."], "golden_acorn_slump_against_it_broke": ["Rich. Unspendable. Solid.", "Gold acorn. Zero bread. Systemic failure."], "golden_acorn_dash_after_it_in_the_wind": ["Not the gold. Anything but the gold.", "Ran, grabbed, panted. Cardio."], "golden_acorn_bow_to_the_gold": ["Your Shininess.", "Bowed thrice. It did not blink."], "golden_acorn_hold_it_up_like_a_trophy": ["Champion of: owning it.", "Look at it. Look at me holding it."], "golden_acorn_slip_on_the_shine": ["Gold is slippery. Noted. Humiliating.", "Down I went. The acorn stayed shiny."], "golden_acorn_cool_off_on_the_cold_gold": ["Cold gold. Best thing it has ever done.", "Money is cool. Literally. Briefly."], "golden_acorn_shake_it_for_a_rattle": ["Solid. No rattle. Dull inside.", "Shook it. Nothing. Same as my last plan."], "golden_acorn_hurl_it_in_a_huff_and_fetch": ["Threw the gold. Found it. Never again. Possibly.", "Rage, grass, apology. In that order."], "golden_acorn_stand_on_it_like_a_podium": ["Gold medal. On a gold acorn. Tidy.", "First place. Only competitor: me."], "golden_acorn_bellow_a_warning": ["Whole yard on notice. One acorn. Mine.", "Shouted it. Pigeons nodded. Fine."]},
