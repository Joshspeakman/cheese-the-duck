 "lines": {"sky_token_wipe_the_mist_up_the_pane_in_tall_streaks": ["Cleared a little sky. Mine now.", "Mist off. The clouds on the token stayed. Loyal."], "sky_token_hold_the_token_up_high_as_if_flying_it": ["Airborne. By proxy. The token did the flying.", "Held it up. Nothing flew. Clouds were embarrassed."], "sky_token_blow_across_the_door_seam_for_a_whistle": ["Whistled. Seam did the note. I did the lungs.", "A tune. Well. A hole with an opinion."], "sky_token_hold_a_wing_up_to_find_which_way_the_wind_blows": ["Wind from the left. Or my left. Or just rude.", "Tested it. Wind: yes. Direction: moody."], "sky_token_lick_the_pane_to_taste_the_cloud": ["Cloud: glass. Disappointing, and no cloud.", "Tastes of window. Fluffy on the outside."], "sky_token_nap_with_his_bill_tipped_up_at_the_pane": ["Dreamt of height. Woke up at ankle level.", "Flew all night. Landed in the same spot."], "sky_token_sulk_because_he_is_grounded": ["Grounded. Has wings. Has opinions about wings.", "Everything flies. Everything, apart from me."], "sky_token_present_the_token_to_a_passing_cloud": ["Behold the sky. It's on show. Entry free. Seats: ground.", "Presented it to a cloud. It drifted off. Rude. Typical cloud."], "sky_token_argue_with_the_clouds_about_right_of_way": ["Cloud cut in. I had right of way. And wings, nominally.", "It drifted off mid-sentence. Typical of the sky."], "sky_token_shout_up_for_the_wind_to_come_back": ["Come back. I wasn't done with you.", "Called the wind. It's at a better party."], "sky_token_tangle_his_wings_mid_flap_and_flop": ["Wing in wing. A very short flight. Wardrobe-related.", "Free. Mostly. One feather's in witness protection."], "sky_token_race_two_cloud_shadows_down_the_rail": ["Photo finish. We both lost. Cloud shadow won.", "A tie. I'm calling it a win for me."], "sky_token_toss_the_hop_to_each_other_and_catch_it": ["Hop, catch, hop. We never agreed what the catch was.", "Nobody dropped anything. Because there was nothing."]},
