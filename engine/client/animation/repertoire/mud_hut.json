 "lines": {"mud_hut_pat_the_daub_smooth": ["Wall smooth. Slightly duck-shaped. Calling it art.", "Patted it flat. Wall feels loved. Wall is mud."], "mud_hut_flap_the_daub_dry": ["Flapped it dry. Mud is slow. I am slower.", "Wings aching. Wall drier. Zero thanks, as usual."], "mud_hut_tuck_the_right_pot_straight": ["Pots straight. Sprouts nod in hut-approved agreement.", "Shoved them into line. They shoved back, politely."], "mud_hut_rap_the_lower_panel": ["Mud walls. Door did not mind. Nobody home anyway.", "Knocked hard. Hut stayed calm. Annoying."], "mud_hut_hook_and_pull_the_latch": ["Latch held. Door held. Duck held a grudge.", "Pulled until my neck complained. Neck wins."], "mud_hut_shout_at_the_right_window": ["No dinner existed. Pure theatre.", "Someone owes me an answer. Or a bun."], "mud_hut_sniff_the_daub_for_straw": ["Mud, straw, history. Mostly mud.", "Sniffed a wall. Smelled of cows. Hut has range."], "mud_hut_shove_the_door_with_a_shoulder": ["Hut did not give. Hut has the whole county behind it.", "Shoulder sore. Door fresh. Rematch tomorrow."], "mud_hut_hide_in_the_stake_corner": ["Ambush. Corner approved. Corner is mud-based.", "Burst out. Stakes rattled. Nobody else cared."], "mud_hut_mud_boat_the_threshold": ["Belly boat. Threshold sea. Sea disappointed.", "Slid for one metre. Counts as a voyage."], "mud_hut_tap_the_daub_for_hollow": ["Sounds hollow behind that bit. Probably my head.", "Tap, tap, tonk. A wall with feelings."], "mud_hut_press_a_bill_print": ["Signed it. Bill-shaped. Archaeology will love this.", "Daub remembers. Daub is a snitch."], "mud_hut_nibble_a_daub_crumb": ["Straw and grit. Two stars. Crunch bonus.", "Tastes like the wall. Rude to eat the wall."], "mud_hut_lean_against_the_warm_daub": ["Warm wall. Better than most relationships.", "Leaned. Wall held. Rare reliability."], "mud_hut_sit_on_the_right_sill": ["Afternoon passed. I did nothing. Good use.", "Feet tucked. Mind empty. Perfect hut posture."], "mud_hut_sulk_at_the_stakes": ["Not speaking to the hut. Hut is not speaking either.", "Sulking in a corner. Corners are underrated."], "mud_hut_kick_the_drift_off_the_step": ["Step cleared. Boots would help. I have no boots.", "Snow gone. Toes gone too. Fair swap."], "mud_hut_rake_leaves_to_the_stakes": ["Leaves in a corner. Wind in a mood. Standoff.", "Raked them. Wind is already redoing it. Spite."], "mud_hut_listen_to_rain_on_thatch": ["Rain on thatch. Free percussion. Mud-hut-only seats.", "Drip, drip, drip. The hut applauds slowly."], "mud_hut_slide_off_the_wet_step": ["Mud floor met mud duck. Even match.", "Slipped elegantly. The elegance was invisible."], "mud_hut_walk_into_the_corner_stakes": ["Stakes were there. Corner did not warn me.", "Face first into hut. Hut did not apologise."], "mud_hut_knock_off_a_daub_flake": ["Bit fell off. Wall will manage. Wall must.", "Too hard. Hut is mud. Mud keeps the receipts."], "mud_hut_bill_caught_between_stakes": ["Stakes took my bill. Stakes returned it. Bruised.", "Bill stuck. Pride stuck deeper."], "mud_hut_stub_a_toe_on_a_pot": ["Pot is fine. Duck is a bruise with a bill.", "Toe lost the argument. Pot gloated."], "mud_hut_pose_in_the_doorway": ["Lord of the daub. Duke of damp. Do bow.", "Empire of mud. Population: one duck."], "mud_hut_present_the_hut": ["Authentic. Eco. Slightly soggy. Book now.", "Fine property. Only two sills, one duck, no taxes."], "mud_hut_argue_with_the_latch": ["Latch refuses to explain. Latch is a coward.", "Won on points. Latch does not do points."]},
