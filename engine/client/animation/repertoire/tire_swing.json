 "lines": {"tire_swing_wipe_flank_clean": ["Wiped the flank. Mud, meet wing. Wing, meet regret.", "It's cleaner. It still hangs there like a dare."], "tire_swing_scrape_the_tread": ["Scraped the muck out. There's a lot of muck. It will return.", "Clean tread. Only my conscience has improved."], "tire_swing_fluff_up_on_the_wall": ["Rubbed my sides on a tyre. Feel groomed. Smell of garage.", "Magnificent again. The tyre's a good sport, being rubber."], "tire_swing_patch_the_scuffed_wall": ["Pressed the flap back down. Held. For now. Like most promises.", "Mended it. Don't ask what with. Spit, mostly."], "tire_swing_chip_frost_off_the_tyre": ["Frost's off. The tyre looks thawed or insulted, hard to tell.", "My bill's gone numb. It chipped what I couldn't feel."], "tire_swing_rub_the_wet_tyre_dry": ["Dried it with my arse. The towel was busy being absent.", "Flank's dry. My tail feathers are now a sponge."], "tire_swing_straighten_the_gale_twist": ["Untwisted the rope. The wind's furious. Good.", "Tyre hangs straight. I'm taking credit."], "tire_swing_brace_against_the_gust": ["Gust hit. I held the post. The post held me. Fair trade.", "Wind's got a grudge against my feathers."], "tire_swing_push_for_a_missing_friend": ["Pushed it harder each time. It didn't giggle. High standards.", "That's more swing than I've had from a friend."], "tire_swing_shove_a_friend_in_the_ring": ["Shoved a friend in the tyre. The friend is the cargo. I am the engine.", "Higher? Higher. Their screaming is technically positive feedback."], "tire_swing_poke_and_run": ["Poked. Ran. It's coming. They always come back.", "I'm not scared. I'm tactically elsewhere."], "tire_swing_dance_with_the_tyre": ["Waltzed with a tyre. It led. I let it. No comment.", "One two three, one two three. Rubber has no rhythm."], "tire_swing_pass_the_tyre_back_and_forth": ["Passed it to a friend, got it back. Best conversation I've had all week.", "We said nothing and the tyre did all the talking."], "tire_swing_count_the_swings": ["Seven swings, then it stopped. So did my interest.", "Counted aloud. The tyre didn't thank me."], "tire_swing_lick_the_tread": ["Road, rain and a bit of dog. Zero bread.", "Tastes how it looks. Like going nowhere, gently."], "tire_swing_balance_on_the_base_plate": ["Four seconds on one foot. Write it down.", "One foot, one plate, zero dignity. Ten out of ten."], "tire_swing_hug_the_tyre": ["Hugged a tyre. It was warmer than expected. So's my face.", "Don't ask what I whispered into it."], "tire_swing_nap_curled_in_the_hole": ["Napped in a tyre. Woke up with a tread pattern on my arse.", "Best bed I never paid for. Smells of garage."], "tire_swing_sulk_at_the_tyre": ["It swings for no one. Same as me, with less voice.", "Leave me. I'm a tyre now. Round and bitter."], "tire_swing_drum_solo_on_the_tyre": ["Drum solo. Muffled but sincere.", "The tyre has one note and it's a sigh."], "tire_swing_sing_into_the_hole": ["The tyre has acoustics. My voice has opinions.", "Sang into a hole. It sang back worse."], "tire_swing_shout_up_at_the_beam": ["Yelled at the beam. It has the high ground and no manners.", "The rope came from up there. Somebody's accountable."], "tire_swing_argue_with_the_tyre": ["It's a circle. A rubber circle. Why's it get all the fuss.", "It hasn't answered back. Typical bully."], "tire_swing_stuck_in_the_hole": ["Head's through, brain's behind. Stuck between them.", "Pulled free. Left a feather and some dignity."], "tire_swing_turned_back_on_the_shove": ["Clocked from behind by a tyre. Telling no one.", "It had a head start and a rope. Unfair."], "tire_swing_kick_the_tread": ["Kicked a tyre. It's been kicked by better.", "My toe has filed an appeal."]},
 "marks": [["frost", 0.3, "*.*.*", "tyre_wall_l", "frost"], ["leaves", 0.3, ",;,.;", "post_base", "leaf"]],
