 "lines": {"shed_scrub_barrel_staves": ["Barrel was grey. Barrel is now brown. Progress.", "Scrubbed until my wing hurt. Barrel does not say thanks."], "shed_mend_the_lower_panel": ["Rail back in. Door looks smug.", "Three taps and a headache. Fixed."], "shed_straighten_the_tools": ["Tools upright. Wall looks organised. Lie.", "Straightened the lot. They lean on principle."], "shed_rake_leaves_off_the_step": ["Leaves in a heap. Wind will undo it. Wind is petty.", "Raked. Step is a step again."], "shed_push_the_door": ["Latched. Whatever is in there stays in there.", "Shoulder met door. Door won."], "shed_tug_the_hook": ["Hook held. Tools wobbled. Wall judged me.", "Pulled. Nothing came off but my confidence."], "shed_peer_over_the_barrel_rim": ["Barrel top is a lid. Disappointing lid.", "Looked in. It looked back, flat and wooden."], "shed_listen_to_the_tin_roof": ["Roof ticks when warm. Roof, you talk too much.", "Heard the tin tick. It is gossiping about the sun."], "shed_drum_the_hoop": ["Barrel has the deepest voice in the yard.", "Drummed it hollow. Empty. Like my plans."], "shed_throw_the_leaves": ["Leaves went up. Leaves came down. Peak cinema.", "Threw them high. Gravity did the rest."], "shed_hook_a_tool_with_a_twig": ["Twig caught the hook. Hook caught nothing. Even.", "Fished at the wall. Wall kept its tools."], "shed_lean_on_the_barrel": ["Warm barrel. Back against it. Done thinking.", "Staves hold the heat. I hold the staves."], "shed_nap_on_the_door_foot": ["Door foot nap. Hard bed. Strong dreams.", "Slept on a strip. Woke up striped."], "shed_sulk_at_the_tools": ["The tools know what they did.", "Not speaking to the T-thing. Or its friend."], "shed_chip_frost_off_the_foot": ["Foot strip iced over. Chipped it free.", "Frost off the door. Nostrils still frozen."], "shed_shelter_in_the_door_foot": ["Roof sounds like a drum kit. Door post is my umbrella.", "Rain on tin. Duck on door. Both of us are loud."], "shed_bill_frozen_to_the_hoop": ["Hoop tastes like regret. And iron. Mostly regret.", "Frozen to a hoop. Bill is not for kissing."], "shed_walk_into_the_shed_door": ["It was latched. It is always latched.", "Face first into a door. Classic me."], "shed_trip_on_the_step_line": ["Step line and I disagreed. It stayed put.", "Sprawled by the barrel. Barrel kept quiet."], "shed_show_off_the_tools": ["Premium tools. Used once. By a duck.", "Hoe, hook, handle. Offers welcome."], "shed_pat_the_crate": ["Good box. Sit. It sat.", "Patted it twice. Box did not wag."], "shed_pull_at_the_lower_panel": ["Pulled. Panel pulled back. Stalemate.", "Door does not open for ducks, it turns out."]},
