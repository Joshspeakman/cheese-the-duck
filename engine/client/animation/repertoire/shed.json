 "lines": {"shed_scrub_left_planks": ["Shed looked lived in. Now it looks cleaned in.", "Planks scrubbed. Wing ruined. Worth it for a plank."], "shed_wipe_left_glass": ["Glass clear. Handsome duck in there. Poor lighting.", "Wiped it. The window did not say thank you."], "shed_tap_ring_plate_back": ["Plate back flat. Shed holds. Applause not required.", "Tap, tap, done. I should bill by the tap."], "shed_rap_door_panel": ["Shed said nothing. Shed keeps its secrets.", "Knocked. Even the rakes ignored me."], "shed_flick_the_latch": ["Clack. It does that. I do that. We bond.", "Latch up, latch down. Riveting work."], "shed_rock_the_barrel": ["Barrel sloshed. Or I did. Hard to tell.", "Shoulder hurts. Barrel has no shoulder. Unfair."], "shed_holler_at_window": ["Window did not answer. Window has no manners.", "Greeted a window. Window left me on read."], "shed_drum_the_staves": ["Barrel has a good bottom end. Poor song structure.", "Four-four time. The barrel plays in three."], "shed_flatten_at_barrel": ["Ambush. Target: nothing. Success rate: complete.", "Barrel did not scream. Weak ambush victim."], "shed_scratch_beside_step": ["Hole. Empty. Plan on track.", "Dug deeper. Found more ground. Disappointing."], "shed_tap_staves_for_full": ["Sounds full. Or sounds sulky. Same noise.", "Hollow at the top, solid below. Like a duck."], "shed_size_up_the_sill": ["Sill is exactly one duck too high. Standard.", "Tall house, short duck. Law of nature."], "shed_sniff_the_barrel_rim": ["Smells of old apples and bad decisions.", "Pickles. Possibly regret. Possibly both."], "shed_sit_on_barrel_rim": ["Throne. Round. Slightly damp. Slightly mine.", "Legs dangling. Barrel steady. Life is acceptable."], "shed_sulk_at_the_step": ["Shed knows what it did. I am waiting.", "Sulking at a shed. New low. Comfortable."], "shed_scoop_snow_off_rim": ["Snow lid off. Barrel has no thanks to give.", "Cold wings. Clean rim. Jury still out."], "shed_rake_leaves_to_heap": ["Leaves in a heap. Wind will undo it. Wind is rude.", "Raked it with my feet. Calling it landscaping."], "shed_skid_on_frosty_lip": ["Frost lied. Lip lied. Duck fell for both.", "Down. Not out. Mostly down."], "shed_march_into_barrel": ["Barrel was there before I was. Etiquette says it wins.", "Rim got my face. Barrel got the last word."], "shed_whack_panel_too_hard": ["Nail skewed. Shed will forgive me. Shed has no say.", "Hit it. It hit back. Lesson ignored."], "shed_bill_stuck_in_latch": ["Latch ate my bill. I got it back. Barely.", "Not my best poke. Possibly my worst."], "shed_pose_on_barrel_rim": ["Ahoy. Nothing. Fine. Sail on.", "Figurehead of a shed. Sails: none."], "shed_present_the_tool": ["Fine tool. Previous owner: the shed. Cash only.", "Gently used. Gently leaning. Gently overpriced."], "shed_argue_with_hook": ["Hook says nothing. Smug about it.", "Won on points. The hook counts nothing."]},
