 "lines": {"salmon_hook_the_drift_out_of_the_run": ["Leaves out of the lane. It can leap at nothing now.", "Raked the run. Salmon will not say thanks, being airborne."], "salmon_look_over_the_torn_fin": ["Fin intact. Pride dented, which heals itself.", "Frayed at the tip. Join the club, mate."], "salmon_beat_a_current_into_the_pond": ["River simulated. Fish is thrilled, duck is soaked.", "Made a current by hand. Got a free workout."], "salmon_throw_flakes_up_the_lane": ["Flakes up, salmon down. The usual physics.", "Dinner from upstream. Very authentic."], "salmon_hold_a_flake_high_for_the_leap": ["Took it mid-air and left. Rude, impressive.", "Almost lost the bill. Worth it."], "salmon_hand_feed_a_flake_at_the_rim": ["It took the flake and my full confidence.", "One flake. It looked at me like I owed it more."], "salmon_draw_it_up_the_home_bank": ["It knows the bank better than I do. I just hold the wing.", "Led it home. It would have gone anyway."], "salmon_raise_the_twig_hoop_for_a_leap": ["Through the hoop clean, not a drop touched. Show-off.", "Hoop work. This is why they give me a twig."], "salmon_race_the_leaps_along_the_bank": ["Lost by four leaps. It cheats with vertical.", "Raced a fish. Lost to the one with fins."], "salmon_measure_the_leap_on_the_cattail": ["Four of me, straight up. I am not the unit that matters.", "Notched the reed. Salmon notched the sky."], "salmon_bow_to_the_high_leaper": ["Bowed. It dripped on my head. A blessing.", "Gave it the bow. It gave me spray."], "salmon_argue_over_who_jumps_higher": ["Twelve to nothing, and it still disputes the scoring.", "Lost to a fish. A fish with no legs."], "salmon_sing_the_run_up_the_river": ["It leapt on the high note. Critics will call it feedback.", "Sang upstream. Nobody was listening, except the fish."], "salmon_flinch_when_it_leaps_at_his_face": ["Cold, wet and entirely on purpose.", "It leapt. I flew. Physics split the difference."], "salmon_herd_it_up_the_lane_from_both_banks": ["Two ducks, one fish, no argument. It is going upstream anyway.", "Herded it a metre. It would have gone ten."], "salmon_judge_the_leaps_with_a_friend": ["Ten from me, nine from the other judge. Fish gets zero for tripping on the landing.", "Scored it. It was a ten. The fish does not know scoring."]},
