 "lines": {"pine_cone_wipe_the_flank_clean": ["Scales scrubbed. All of them. Hundreds.", "Clean cone. Prickly as ever. Same personality."], "pine_cone_carry_it_by_the_stem": ["Prickly. Carried anyway. That is called dedication.", "Walked it over. Walked it back. Pointless. Nice."], "pine_cone_roll_it_in_a_wobbly_arc": ["Cones do not roll straight. Cones have opinions.", "It curved. I followed. We both ended up somewhere."], "pine_cone_stash_it_in_the_leaves": ["Hid a pinecone. Secret known only to me and every squirrel.", "Under the leaves. Very sneaky. Very prickly."], "pine_cone_press_a_cheek_and_regret_it": ["Pointy. Obviously pointy. I knew that.", "Tested my cheek. Results: ow."], "pine_cone_count_the_rows_of_scales": ["Lots. More than lots. Cone is mostly scale.", "Lost count at row nine. Blamed the cone."], "pine_cone_hold_his_ear_to_the_belly": ["Rustle. Wind. Not the cone. Cone has nothing to say.", "Nothing inside. It is a very tight cone."], "pine_cone_sit_square_and_wait": ["Still a cone. I give it ten more minutes.", "Not one word. Respect to the cone."], "pine_cone_stand_guard_chest_out": ["Squirrels, be warned. This cone is mine.", "Guarding a pinecone. I have standards. Low ones."], "pine_cone_shelter_in_its_lee_from_the_rain": ["Shelter: one pinecone. It helps eight percent.", "Rain on one side, scales on the other. Even."], "pine_cone_bow_to_the_cone": ["Your Evergreenness.", "Bowed to a pinecone. No witnesses. Good."], "pine_cone_present_the_cone_to_nobody": ["Ladies, gentlemen, woodland.", "The forest. Compact edition."], "pine_cone_hook_it_closer_with_a_twig": ["Fished a pinecone out of the yard. Caught nothing else.", "Hooked. Landed. Released. Cone looked unmoved."], "pine_cone_whip_the_wet_off_the_cone": ["Wet pinecone. Wetter me.", "Whipped it. Rain went everywhere but away."]},
