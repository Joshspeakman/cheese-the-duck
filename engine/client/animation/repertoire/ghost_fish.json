 "lines": {"ghost_fish_lift_the_leaves_without_a_ripple": ["Not one ripple. A ghost would approve of that.", "Lifted them out like eggs. Dull, but the fish stayed."], "ghost_fish_sweep_the_grit_so_the_glow_shows": ["Grit out, glow in. Housework with a theme.", "Cleared the shallows. It still would not come close."], "ghost_fish_ease_a_weed_strand_off_the_pale_fin": ["Off. Not a ripple from either of us.", "It stayed. Ghosts leave early. This one gave me a pass."], "ghost_fish_offer_a_flake_to_the_glow": ["Took it. Said nothing. Perfect guest.", "A flake, taken by a ghost. I will tell nobody."], "ghost_fish_hum_it_a_lullaby_at_the_rim": ["Hummed it a lullaby. It stayed. Better reviews than my band.", "Soft enough that the water forgot me."], "ghost_fish_draw_a_glimmer_line_with_a_wingtip": ["A line of light. I did that. With a wing.", "Wrote my name in fish glow. Reads 'ow', the fish moved."], "ghost_fish_count_the_pulses_of_the_glow": ["Slow. It breathes light like a snore.", "Counted six, then it dimmed. Rude to a counter."], "ghost_fish_bow_to_the_ghost_of_the_pond": ["Bowed to a haunting. We got on.", "Very pale, very polite. Better manners than mine."], "ghost_fish_argue_in_a_whisper": ["It claims the haunting. I claim the tenancy.", "Lost a whisper fight to a fish. Dignity gone, haunting intact."], "ghost_fish_show_it_off_to_the_far_cattails": ["Showed them the glow. Cattails nodded in the wind. Agreed.", "Whispered a fish to the reeds. They kept it quiet."], "ghost_fish_jump_back_from_the_sudden_flare": ["It lit up. I did not. We are not alike.", "A flash, a shriek, a duck three feet back. Textbook."], "ghost_fish_pass_the_lullaby_down_the_rim": ["Passed the lullaby on. The fish stayed. Rare tribute.", "A duet in a whisper. It had perfect pitch, probably."], "ghost_fish_count_the_pulses_back_to_back": ["Six. Or five. Glow pulses when it wants to.", "Counted aloud and a friend counted silent. Silence won."]},
