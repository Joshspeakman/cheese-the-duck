 "lines": {"ancient_amulet_wipe_the_breath_mist_off": ["Clear. Now the amulet can see me.", "Mist gone. Evidence gone."], "ancient_amulet_count_the_rays_with_a_twig": ["Twenty-odd rays. One amulet. Poor ratio.", "Lost count at nine. Blamed the amulet."], "ancient_amulet_lift_it_out_to_look_closer": ["Out of the case. Sirens: none. Result.", "Held it up. It caught the light and my ego."], "ancient_amulet_mouth_the_cord_and_spit": ["Old. Dusty. Tastes like a museum's armpit.", "Ancient. Tastes ancient. Spat."], "ancient_amulet_rub_it_bright_on_his_chest_feathers": ["Buffed on my own chest. The amulet got lucky.", "Shiny. Smells like duck. Fair trade."], "ancient_amulet_shoulder_the_case_to_see_if_it_budges": ["Not an inch. Solid case. Rude.", "Heavier than it looks. So am I."], "ancient_amulet_boot_the_bottom_rail": ["That's for the glass. And the price.", "Kicked the rail. Foot hurts. Rail won."], "ancient_amulet_knock_on_the_base_for_the_hollow": ["Hollow. Like my wallet.", "Nobody inside. Only the amulet, upstairs."], "ancient_amulet_lick_the_polished_rail": ["Tastes like the inside of a coin.", "Not brass. Disappointing. Still licked."], "ancient_amulet_squint_at_his_own_face_beside_it": ["I am more handsome. It is more expensive.", "Same eyes, near enough. Mine are cheaper."], "ancient_amulet_doze_off_with_his_bill_at_the_rail": ["Guarding the amulet. Eyes shut. Tactic.", "Wake me when it opens."], "ancient_amulet_sit_square_and_wait_for_the_doors": ["Any door now.", "I can wait. I have time and bread."], "ancient_amulet_follow_the_moonlight_up_the_medallion": ["Moon on the medallion. Moody. Good.", "It glints at night. Show-off."], "ancient_amulet_sweep_a_wing_up_toward_the_amulet": ["Behold. Do not touch. I mean me.", "Ancient. Glittering. Mine, in spirit."], "ancient_amulet_argue_with_the_glass": ["Open up. I know you are in there.", "Glass: smug. Amulet: smugger."], "ancient_amulet_shout_up_at_the_amulet_to_come_down": ["Come down here and say that.", "Nothing. It has a good lawyer."], "ancient_amulet_stuck_to_the_fogged_glass": ["Stuck. Own fault. Own breath.", "Pop. Nose still attached. Mostly."], "ancient_amulet_topple_over_craning_too_far_back": ["Looked up. Fell down. Physics is rude.", "Backwards. Elegant. No witnesses."]},
