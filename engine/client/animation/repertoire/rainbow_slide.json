 "lines": {"rainbow_slide_polish_the_lanes": ["Shiny. Now the colours look at me back.", "Polished it. Streaks stay. So do I."], "rainbow_slide_tighten_foot_bolt": ["Bolt tight. Squeak gone. I accept the credit.", "Turned it with my face. Engineering."], "rainbow_slide_plough_the_apron_drift": ["Drift ploughed. I am a snowplough with opinions.", "Snow on my bill. Not a good look."], "rainbow_slide_listen_to_the_rail": ["Rail hums in the wind. Off-key. Typical.", "Heard a note. Told it to stop."], "rainbow_slide_slalom_the_posts": ["Won. Unopposed. Still a close finish.", "Lap four. Legs are voting to leave."], "rainbow_slide_nap_on_the_first_deck": ["Deck is hard. Dreams are soft. Net win.", "Slept on a plank. Spine filed a complaint."], "rainbow_slide_slide_on_the_slick_apron": ["Skidded. Face first. Rainbow looked on.", "No harm. Mostly to my reputation."], "rainbow_slide_bonk_the_foot_bolt": ["Bolt won. Bolt is metal. Obviously.", "I butted a bolt. My plan had holes."], "rainbow_slide_present_to_the_rainbow": ["Rainbow for the slide. Zero for me. Bitter.", "Look at it. Look. Okay, enough."], "rainbow_slide_plunge_down_beak_first": ["Fastest duck on the rainbow. Sole entrant.", "Beak first. Lessons: none learned."], "rainbow_slide_stop_hard_at_the_foot": ["Heels dug in. Chin dug in more.", "Brakes work. Face is the brakes."], "rainbow_slide_stub_a_toe_on_the_post": ["Post: 1. Toe: 0. Language: unprintable.", "Hopped. Swore. Still own a post-shaped grudge."], "rainbow_slide_drum_the_wide_apron": ["Clog dance. Garden gives a tepid hand.", "Four beats, eight feet, one duck."], "rainbow_slide_throw_a_billful_of_grit": ["Missed. Post did not even blink.", "Aim: poor. Mood: improved."], "rainbow_slide_climb_up_the_run": ["Up the run. Run objected. I won.", "Slid back twice. Called it cardio."], "rainbow_slide_shout_up_the_ladder": ["Top rung says nothing. Wind took notes.", "Shouted at a ladder. It said nothing. Respect."], "rainbow_slide_show_off_each_lane": ["Red, plum, splorg. I invented one.", "Colours are a suggestion. I suggest new ones."], "rainbow_slide_taste_the_paint": ["Purple tastes like purple. Rude.", "Licked the rainbow. Nothing sweet. Fraud."]},
