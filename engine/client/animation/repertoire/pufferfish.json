 "lines": {"pufferfish_wipe_the_wall_clean_at_beak_height": ["Eyes unblocked. It looked at me and promptly puffed. Gratitude, probably.", "Clean wall. Same fish. Same opinion of me."], "pufferfish_peer_for_any_bent_spine": ["All spines straight. Alarming for a creature that cannot hold a grudge.", "No bent ones. It has better posture than me."], "pufferfish_press_a_hard_crumb_to_the_wall": ["Crunched it like a tiny wood chipper.", "A beak made for rocks, eating my crumb with feeling."], "pufferfish_scatter_hard_crumbs_over_the_coping": ["Crumbs over the top. Chomp, chomp, tiny ferocity.", "Fed it from above like a god. A small, disappointed god."], "pufferfish_walk_it_slowly_along_the_wall": ["Walked it round. It forgot to be afraid, which is a start.", "Wing, wall, puffer. Slow therapy."], "pufferfish_prod_the_wall_sharp_to_see_it_pop": ["Poof. The wall is now mostly puffer.", "Prodded it once. Balloon season is open.", "That was cheap and I would do it again."], "pufferfish_lay_a_calm_wing_flat_on_the_wall": ["Down it went, one sigh at a time. Contagious.", "Slow breath. The puffer copied me and remembered itself."], "pufferfish_puff_up_back_at_the_puffer": ["Neither of us won. We both turned a bit purple.", "Stand-off. I blinked first. I always blink first."], "pufferfish_measure_the_balloon_against_a_wing": ["Three wing widths ballooned, one and a half relaxed. Physics is rude.", "It doubles and halves on a whim. Not a reliable specimen."], "pufferfish_bow_to_the_round_little_boss": ["It swelled a bit. We understand each other.", "Bowed to a pufferfish. The day has peaked."], "pufferfish_argue_about_who_is_rounder": ["It won. Rounder by an arc.", "I have been out-rounded by a fish the size of a pear."], "pufferfish_shout_the_alarm_at_a_phantom": ["There was nothing there. It believed me anyway.", "False alarm, true balloon."], "pufferfish_leap_back_from_the_sudden_balloon": ["It was small, then it was a planet.", "Swore I saw a face on it. A cross one."], "pufferfish_pass_a_hard_crumb_down_the_wall": ["Beak to beak, crumb to crumb. A puffer relay.", "Two ducks feeding one balloon. The usual civic duty."], "pufferfish_calm_it_from_both_sides_of_the_wall": ["Two quiet wings and one fat balloon. It deflated out of politeness.", "A puffer talked down. Wings only, no words."], "pufferfish_guess_the_number_of_spines_with_a_friend": ["Ninety and a hundred. The fish counted none. Fair.", "Nobody was right. The puffer kept the answer."]},
 "marks": [["puff", 0.3, "*(O)*", "bob_m", "water"], ["crumbs", 0.3, ".o.o.", "puff_r", "dust"], ["pond_flakes", 0.3, ".':.'", "skin_m", "dust"], ["pond_leaves", 0.3, ";\"~;\"", "top_m", "leaf"], ["pond_ice", 0.3, "*-*-*", "top_l", "frost"], ["pond_algae", 0.3, "\"v\"v\"", "base_m", "plant"]],
