 "lines": {"water_token_wipe_the_beaded_drops_off_the_pane_in_columns": ["Beads off. They'll be back. Water has a long memory.", "Wiped every drop. Counted none. Respect."], "water_token_shake_himself_dry_from_bill_to_tail": ["Shook. Sprayed. Nobody saw. Everybody's damp.", "Dry enough. The rest is character."], "water_token_tilt_the_token_to_watch_the_drop_wobble": ["Nothing spilled. It's a picture of water. I checked twice.", "Tilted it. The wave stayed polite. Drama-free water."], "water_token_race_the_drips_down_the_pane_and_lose": ["Backed the left one. Right one cheated.", "Lost to a drip. Not my best week."], "water_token_lick_a_bead_off_the_glass_to_test_it": ["Just rain. Rain with notes of window.", "Tastes of nothing. Wet nothing. Refreshing."], "water_token_hold_the_token_to_his_ear_like_a_shell": ["Heard the sea. Or my own head. Same sound.", "It said shhh. Everyone says shhh to me."], "water_token_nap_to_the_rhythm_of_the_drips": ["Drip. Drip. Drip. Zzz. Drip.", "Lulled by water. Woke up thinking I was a pond."], "water_token_sulk_under_his_own_small_raincloud": ["Tiny raincloud. Personal. Tailored.", "It follows me. It's the closest thing I have to a friend."], "water_token_present_the_token_to_the_dry_land": ["An ocean. Small. Pocket-sized. Ocean-adjacent.", "Presented the sea to a patch of floor. Floor unmoved."], "water_token_argue_with_the_tide_about_who_is_in_charge": ["The tide went out mid-argument. Cowardly. Wet. Cowardly.", "I win. Water has no counter-argument. It just drips."], "water_token_shout_for_the_sea_to_come_out_and_fight": ["The sea declined. Weak showing.", "Challenged an ocean. It sent a drip."], "water_token_wedge_his_bill_in_the_seam_and_pull_out_with_a_pop": ["Stuck by the beak. Beak's very stubborn. So am I.", "Popped out. Seam kept some of my dignity."], "water_token_splash_fight_with_a_friend_at_the_foot": ["Soaked. Neither of us is even wet. Fully committed.", "He splashed first. I splashed harder. Honour restored."], "water_token_lift_the_token_so_a_friend_can_hear_the_sea": ["Friend heard the sea. Friend heard me breathing. Same noise.", "Held it low. They said waves. I said bread."]},
