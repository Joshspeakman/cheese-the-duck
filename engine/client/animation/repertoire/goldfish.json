 "lines": {"goldfish_fish_a_leaf_out_by_its_stem": ["One leaf. Out. The pond acts like it never happened.", "Bill-fishing. Catch of the day: foliage."], "goldfish_tap_the_surface_for_the_dinner_call": ["Tap tap tap. They are learning. One of them is.", "A call. Dinner. They remember for a whole minute."], "goldfish_dangle_a_flake_and_snatch_it_back": ["Nope. Again. Nope. Fine, take it.", "I am the dinner service. With a sense of humour."], "goldfish_let_it_nibble_the_tip_of_his_bill": ["Nibbles. Little ones. I am a very long snack.", "Tickles. Do not tell anyone I laughed."], "goldfish_count_the_flakes_by_the_snatches": ["Eight flakes. It always wants nine.", "Counted. Fed. Insatiable. I know the feeling."], "goldfish_hoist_a_flake_for_it_to_leap_at": ["Jumped. A tiny fish. A tiny, majestic fish.", "It got air. I got a flake-shaped hole in my pride."], "goldfish_blow_a_big_bubble_and_watch_it_pop": ["Pop. Both of us jumped. One of us pretended not to.", "Biggest bubble yet. Smallest audience."], "goldfish_play_red_light_green_light_along_the_rim": ["It froze first. I moved. It is cheating by being a fish.", "Green light. Red light. It won. It always wins."], "goldfish_count_the_scales_down_its_flank": ["Forty. Fifty. It moved. Start again.", "Scales: many. Patience: fewer."], "goldfish_wait_for_it_to_remember_him": ["Hi. No? Hi again. Third time, it knows me.", "It forgets me every lap. I am introduced forever."], "goldfish_turn_away_from_a_fish_that_forgot_him": ["Forgot me. Again. Three seconds, they said.", "I remembered its name. It did not remember mine. Fine."], "goldfish_cool_his_feet_while_it_nibbles_his_toes": ["Cool feet. A nibble. Nobody tell my toes.", "Toe-nibbling. Nobody warned me. Great."], "goldfish_argue_with_the_goldfish_about_its_memory": ["I fed you at noon. You said thanks. You don't remember.", "It has no idea who I am. Good fight."], "goldfish_call_it_by_name_across_the_pond": ["Goldie. Goldie. It is not called Goldie. I do not know its name.", "Called it. Nothing. It is on a break."], "goldfish_sing_the_goldfish_a_lullaby_in_threes": ["Three verses. It remembers none. The song is a gift.", "Soft song. Soft fish. Mine, for three seconds."], "goldfish_tip_the_whole_pile_in_at_once": ["Too many. Pond now looks like soup. Fish: delighted.", "I meant to pour less. I meant a lot of things."], "goldfish_hop_up_when_it_nips_a_toe": ["It bit my toe. It is the size of a thumb.", "Nipped. By a flake-sized monster."], "goldfish_search_the_pads_together_for_the_goldfish": ["Found it. It was right there. It was always right there.", "Two ducks, one fish, one hide and seek that it did not agree to."]},
