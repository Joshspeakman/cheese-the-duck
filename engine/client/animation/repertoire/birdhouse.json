 "lines": {"birdhouse_wipe_pole": ["Pole's clean. The house won't notice. I'll know.", "Grime's on my wing now. It travels."], "birdhouse_stamp_soil_flat": ["Stamped it down. Soil can't say I didn't try.", "Pole's snug again. Nobody's grateful. Standard."], "birdhouse_knock_like_a_door": ["Three knocks. Polite. Can't say I didn't try.", "Either empty or ignoring a duck. Even odds."], "birdhouse_shout_up_the_doorway": ["Hello. It's a duck, not a bailiff.", "The roof echoed. The roof sounds smug."], "birdhouse_prod_the_ledge": ["Ledge is empty. I checked with a stick, like a professional.", "If a twig says no one's home, that's legally binding."], "birdhouse_peek_round_the_pole": ["The pole kept dead still. Poor sport.", "Peek one. Peek two. The tension was all mine."], "birdhouse_maypole_spin": ["Round the pole, wing hooked, no ribbons. Budget cuts.", "Dizzy. Delighted. Both the pole's fault."], "birdhouse_chase_his_tail_round_the_pole": ["Caught it. Didn't know what to do. Same as every chase.", "Dizzy, dignified. Pick one."], "birdhouse_measure_himself_against_the_pole": ["Same mark as last time. No growth. Bread, please.", "Marked my height on a pole. It's something."], "birdhouse_dig_beside_the_slab": ["Dug a bit. The soil went deeper than I wanted to follow.", "A hole's just soil changing its mind."], "birdhouse_wait_for_a_tenant": ["Still no tenant. Either the rent's off or the pole is.", "I'm not waiting. I'm standing here. Neutrally."], "birdhouse_rub_the_wet_pole_dry": ["Dried it with my chest. My feathers have gone mournful.", "Dry pole, damp duck. Fair trade, by somebody's maths."], "birdhouse_follow_a_raindrop_down": ["Raced a raindrop. Lost. It had gravity.", "It reached the bottom first and had the decency to vanish."], "birdhouse_doorman_stance": ["Doorman. Employer's out. Pay's atrocious.", "Anyone gets past me, I'll look at them hard."], "birdhouse_act_out_a_birds_arrival": ["That's how a bird does it. Landing: seven. Dismount: wet.", "Practising for when I'm allowed in."], "birdhouse_crow_at_dawn": ["I'm a duck. The noise is the same as long as you commit.", "Sunrise has been told. It can go on now."], "birdhouse_stakeout_from_the_slab": ["Sat for an hour. Saw a leaf. It was brilliant.", "If anyone moves in, I've got dibs on the ledge."], "birdhouse_flap_at_the_pole": ["An inch up. Personal best. Gravity says nice try.", "Wings work. The rest of me is on a different contract."], "birdhouse_toppled_looking_at_the_roof": ["The roof's fine. I'm horizontal. Thanks for asking.", "Looked up too hard. The pole watched me fall. No comment."], "birdhouse_twig_whacks_back": ["Hit myself with my own stick. Elegance, check.", "The edge won. The edge didn't even do anything."]},
