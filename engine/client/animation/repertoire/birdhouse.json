 "lines": {"birdhouse_wipe_the_pole": ["Pole's clean. The house won't notice. I'll know.", "Grime's on my wing now. It travels."], "birdhouse_scoop_snow_off_the_slab": ["Snow's off the slab. The house stays snug, smug and tall.", "Dug out a doormat. No one's coming."], "birdhouse_brace_against_the_pole_in_the_gale": ["Wind wants the house. I'm in the way. Good.", "The pole creaks. I creak louder."], "birdhouse_knock_at_the_door": ["Knocked. A friend answered from the pole. House stayed silent.", "Who's there? Me. Me who? Me, the duck."], "birdhouse_shove_the_pole": ["Shoved it. It shrugged. I've been out-stubborned by timber.", "Not a wobble. Shame."], "birdhouse_dig_at_the_foot": ["Dug a hole beside a pole. The pole is unmoved. So am I.", "Found dirt. More dirt. Called it progress."], "birdhouse_press_the_pit_flat": ["Filled it in. Evidence gone. Never happened.", "Stamped it flat. The ground can sulk, I've seen worse."], "birdhouse_chase_a_friend_round_the_pole": ["Chased a friend round a pole. The pole stayed neutral.", "Caught a friend. Released on pole-parole."], "birdhouse_taste_the_pole": ["Wood, rain, bird. Not food, not even insulting food.", "Tastes like somebody else's front door."], "birdhouse_balance_on_the_foot_slab": ["Slab, foot, wobble. Knees in the wind.", "One foot, one slab, zero dignity. Ten out of ten."], "birdhouse_hug_the_pole": ["Hugged a pole. It's the most reliable friend I have.", "Don't ask what I whispered into the wood."], "birdhouse_sulk_at_the_pole": ["House has a door and a view. I have a pole.", "Sulking costs nothing. Best deal I've had."], "birdhouse_shout_up_at_the_roof": ["Shouted at the roof. Roof's got height and no manners.", "I'll wait. I've got all day and no plans."], "birdhouse_sing_up_the_pole": ["Sang up the pole. The pole hummed along and did the harmony.", "Sang a lullaby to an empty house. It slept."], "birdhouse_argue_with_the_doorway": ["Told the house what I think. It didn't answer, so I win.", "House has no windows. Smart. Dodges all feedback."], "birdhouse_show_the_house_to_a_friend": ["Showed a friend the house. They were impressed. They're easily impressed.", "That's the whole tour. Gift shop's closed."], "birdhouse_kick_the_pole": ["Kicked the pole. The pole kicked back, with the wood.", "The big toe wants a lawyer."], "birdhouse_knocked_his_head_on_the_ledge": ["Ledge 1, skull 0. Rematch denied.", "That's a hard step for a soft head."], "birdhouse_shook_the_pole_and_wore_the_snow": ["Shook the pole. All the snow, one duck. Efficient.", "Feels like a hat. A cold one."]},
