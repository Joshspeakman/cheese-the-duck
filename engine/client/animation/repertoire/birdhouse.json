 "lines": {"birdhouse_landlord_tour": ["Three holes, no tenants, good light. I'd rent it. Obviously not to birds.", "Inspected. Damp's a bit mean in the corners. Standard."], "birdhouse_peekaboo_through_the_holes": ["Boo. Nobody's in. Boo anyway.", "It's a game of one. Winner: me. Loser: also me."], "birdhouse_belly_flop_in_the_leaves": ["Leaves. Pile of. I'm in it. Mood: soft.", "Do not tell the birdhouse I did that. It's fussy."], "birdhouse_listen_at_the_hole": ["Nothing in there but my own breathing. Which is a lot, actually.", "Quiet. Suspiciously quiet. Probably an ambush."], "birdhouse_sniff_the_dark": ["Smells like pine and tiny feet. Tiny judgemental feet.", "Dust. Old dust. Dust with opinions."], "birdhouse_sulk_facing_the_wall": ["Houses for everybody. Except me. I live in a puddle with a lot of principles.", "Fine. Stay in there. I'll keep the wall company."], "birdhouse_wait_by_the_low_hole": ["Nobody in. Nobody out. Roommate goals.", "It's quiet. That's the whole house's personality."], "birdhouse_doorman_bow": ["Welcome. Mind the step. Do not bring your friends.", "Fully staffed. By me. Salary: bread."], "birdhouse_estate_agent_pitch": ["Three bedrooms, no kitchen, no bathroom. Open plan. Don't look up.", "Near a duck. Transport links: wings."], "birdhouse_lecture_the_centre_hole": ["I'm not shouting. I'm projecting.", "Nobody's in there. I'm winning the argument."], "birdhouse_stamp_the_puddle_under": ["Puddle's mine. The house can have the dry bit. It's welcome.", "Splash. Splash. Dignity's overrated."], "birdhouse_head_stuck_in_the_hole": ["Stuck. Not panicking. Just thinking about it. With my arse.", "It was bigger when I looked at it. That's not my fault. That's perspective."], "birdhouse_bonked_by_the_swinging_house": ["OW. Shit. Okay. Zero stars, would touch again.", "House hit back. Of course it did."]},
