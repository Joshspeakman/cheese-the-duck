 "lines": {"rubber_duck_squeeze_the_belly": ["Squeak. Honest noise. Better than most of the things I say.", "I'm fairly sure that's its whole personality."], "rubber_duck_muffle_the_squeak": ["Quiet. Shh. Quack's a better noise anyway.", "It squeaks. I lean. We both know who wins."], "rubber_duck_stir_the_ripples": ["Ripples. Mine. Every one personally authorised.", "It bobs when I tell it to. It's the only one that does."], "rubber_duck_spin_the_tail": ["Round it goes. Nobody's seasick. Not yet.", "I spun a duck. Put that on my tombstone."], "rubber_duck_sniff_the_patch": ["Rubber. Bleach. Regret. Someone's childhood.", "Smells like a bathroom. Not mine. I use the pond."], "rubber_duck_sulk_at_the_tail": ["It's got a smile painted on. Must be nice. Mine's real effort.", "Don't squeak at me. I'm not in the mood to be agreed with."], "rubber_duck_hug_the_duck": ["It squeaks when you hold it. That's the nicest thing anyone's said to me today.", "Don't tell anyone. I'm hugging a toy. It's fine. It's research."], "rubber_duck_compare_profiles": ["Same beak. Same colour. Mine moves. Edge: me.", "Pretty sure we're related. On the paint side."], "rubber_duck_claim_to_be_the_real_one": ["I'm the real one. You can tell because I get tired and have opinions.", "It squeaked at me. Rude. First person to disagree all week."], "rubber_duck_critic_walk_round": ["Too round. Too yellow. Too confident. Four stars.", "Excellent bill. Dreadful arse. Critics will talk."], "rubber_duck_stamp_the_puddle_round_it": ["Puddle. Mine. The duck can float there if it wants.", "Wet feet. Dry principles."], "rubber_duck_squeak_blast": ["That was a lot of squeak. I now hear in ducks.", "OW. Shit. Okay. Zero stars, would touch again."], "rubber_duck_squeaked_in_the_ear": ["It squeaked into my ear. Now I hear squeaks. Everywhere. I'm doing a squeak.", "Never again. Until Thursday."]},
