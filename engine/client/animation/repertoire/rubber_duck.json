 "lines": {"rubber_duck_wipe_the_belly": ["Belly's wiped. It's still a belly. I still did it.", "Rubber shines. Smug rubber, now."], "rubber_duck_buff_the_bill": ["Bill's gleaming. I could see me in it, if I looked.", "Chest feathers: the only cloth I own."], "rubber_duck_squeeze_the_belly": ["Squeak. Honest noise. Better than most things I say.", "One note, and it sticks to it."], "rubber_duck_spin_it_by_the_tail": ["Round it goes. Stomachs hold. Yet.", "I spun a duck. Put that on my headstone."], "rubber_duck_sumo_bump": ["Sumo rules: bump, back up, bump. It lost on points.", "Belly to belly. Mine's the squishier opinion."], "rubber_duck_sniff_the_wing_mark": ["Rubber, bleach, someone's childhood, boiled.", "Smells like a bathroom. Not mine. I use the pond."], "rubber_duck_stare_into_the_eye": ["It never blinked. Painted open. Cheating.", "Won on a technicality. The technicality's rubber."], "rubber_duck_bask_on_the_warm_rubber": ["Warm rubber. Better than a bed. Smells like one, too.", "Thawing against a duck. Tell no one."], "rubber_duck_claim_to_be_the_real_one": ["I'm the real one. I tire and have opinions.", "It squeaked at me. First one to disagree in a week."], "rubber_duck_shake_the_bill_like_a_hand": ["Pleased to meet you. Nice grip. No blood flow.", "It didn't give its name. Rude, or brief."], "rubber_duck_critic_circle": ["Too round, too yellow, too confident. Four stars.", "Excellent bill, dreadful tail. Critics will talk."], "rubber_duck_overreached_for_the_crest": ["Reached the crest. Almost. My arse got there first.", "Twig, balance, gravity. Gravity's a sore winner."], "rubber_duck_ear_to_the_belly": ["Hollow in there. Echoes. Reminds me of me.", "Something rattles. Something always rattles."], "rubber_duck_hug_the_duck": ["It squeaks when you hold it. Nicest thing said to me today.", "Research. A hug. A toy. For science."], "rubber_duck_shoved_the_neck_and_took_the_nod": ["It nodded back. Harder. Better swing than mine.", "That's a head with a grudge."], "rubber_duck_rain_drumming_on_its_head": ["Rain on a rubber head. A drum with a punchline.", "Sounds like thinking. Mine, usually."], "rubber_duck_squeak_in_the_face": ["That was a lot of squeak. I now hear in ducks.", "My ears are ringing in rubber."], "rubber_duck_squeaked_in_the_ear": ["It squeaked into my ear. Now I hear squeaks. Everywhere.", "Never again. Until Thursday."]},
