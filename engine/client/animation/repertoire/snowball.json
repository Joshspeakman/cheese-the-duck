 "lines": {"snowball_pat_it_firm_with_both_wings": ["Packed it tight. It is very proud. Cold, but proud.", "Pat pat. Snow behaves for exactly ninety seconds."], "snowball_shape_the_slumped_side_round": ["Round again. Mostly. Round-ish.", "Reshaped the lump. I am a sculptor now."], "snowball_mop_up_the_melt_at_its_foot": ["Mopped. Melting is just crying with extra steps.", "Dry foot. Wet duck. Net zero."], "snowball_shove_it_off_and_fetch": ["Shoved it. It rolled. I followed. A team.", "Snowball: heavy. Me: heavier. Mostly."], "snowball_kick_it_hard_and_regret_it": ["Ice. It was mostly ice. Toe disagrees with me.", "Kicked a snowball. Snowball: unmoved. Toe: furious."], "snowball_dig_a_toe_into_the_lump": ["It does not come out. It is a lump with plans.", "Dug at it. Lump holds."], "snowball_race_it_down_the_yard": ["Lost to a snowball. It cheated: no legs.", "Race. Rematch. Rematch. Rematch."], "snowball_lick_it_to_see_what_cold_is": ["Cold. Wet. Like a bad idea.", "Tastes like snow. Tastes like regret. Same thing."], "snowball_peer_at_the_round_patch": ["No idea what the patch is. I respect that.", "It is a patch. It does not volunteer more."], "snowball_weigh_up_the_ball_against_himself": ["Same size. I am better looking.", "We are even. Do not tell the ball."], "snowball_sit_by_it_and_wait_for_it_to_melt": ["Watched it all afternoon. It lost, like me.", "Waiting for it to melt. It waits for me to leave."], "snowball_stand_guard_against_the_sun": ["Shade duty. Sun, you shall not pass.", "It is melting. I am the umbrella. Nobody asked."], "snowball_watch_it_drip_in_the_warm": ["Drip. Drip. That is a goodbye.", "Dying slowly. Dramatic little ball."], "snowball_bow_to_the_snowball": ["Your Frostiness.", "Bowed. It did not melt with joy. Rude."], "snowball_present_the_ball_to_the_yard": ["Behold: a spherical event.", "Ladies, gentlemen, orb."], "snowball_skate_off_the_icy_edge": ["Ice. Ice everywhere. Ice was the plan.", "Flat on my back. Snowball watched. Smug."], "snowball_press_the_patch_to_hear_a_click": ["No click. It just takes it.", "Pressed the patch. Patch absorbed the insult."], "snowball_hug_the_whole_ball_round": ["Hugged a snowball. I am very cold and very fine.", "Do not mention the hug. The ball will deny it."], "snowball_span_it_with_both_wings": ["Wider than my wings. Fine. Fat ball.", "Measured it. Needed more wing."]},
