 "lines": {"magic_acorn_rub_the_glow_awake": ["There. Brighter. Do not ask what it is for.", "Glow up. Literally. I worked for that pun."], "magic_acorn_cup_wings_round_the_glare": ["Dimmed it. Retinas saved.", "Turned the light down. Like a very strange lamp."], "magic_acorn_scuff_the_grime_off_the_stalk": ["Clean stalk. I smell of acorn now.", "Rubbed it on my chest. Dignity: negotiable."], "magic_acorn_carry_it_like_a_lantern": ["Lantern duck. Smug, bright, lost.", "Walked it round the yard. The yard did not thank me."], "magic_acorn_smother_it_in_a_wing": ["Buried. Still glowing through the dirt. Subtle.", "It lit up the hole. Terrible at secrets."], "magic_acorn_sing_it_louder": ["The note went in. The light came out. Acorn Karaoke.", "Apparently it likes my voice. Only one."], "magic_acorn_hold_it_under_his_chin_to_spook": ["Boo. Nobody was there. It still counts.", "Spooked myself. Very efficient."], "magic_acorn_listen_for_the_hum": ["It hums. Low. Off-key. Like my cousin.", "Hum confirmed. Source unknown. Tolerated."], "magic_acorn_weigh_the_light_thing": ["Light as air. Smug as a nut.", "Weighs nothing. Costs my whole attention."], "magic_acorn_stare_into_the_glow": ["Saw a colour. Did not have a name for it.", "Stared. It stared back. Neither blinked. I lost."], "magic_acorn_wait_for_it_to_pulse": ["Waiting for the pulse. Pulse is on its own schedule.", "Five more minutes of waiting. I am patient for no one else."], "magic_acorn_read_the_ground_by_its_light": ["Light is good. Crumbs are absent.", "Searched by acorn light. Found dirt. Rich dirt."], "magic_acorn_bow_to_the_light": ["Bowed. It brightened. Good. Respect works.", "I do not know what it is. I bow anyway."], "magic_acorn_present_the_glow_to_nobody": ["Behold. A nut that lights up. Applause.", "No tickets. No refunds. Just glow."], "magic_acorn_perch_on_its_cap_in_the_light": ["Wizard duck. Power level: acorn.", "Stood in the light. Felt something. Probably hunger."], "magic_acorn_slip_off_the_glassy_shell": ["Floor and I had a moment. It won.", "Slipped on a magic nut. Lawsuit pending."], "magic_acorn_get_zapped_by_a_spark": ["Zapped. Bill tingles. Might be a power.", "Acorn bit me. Back. Bit it back. Zapped again."], "magic_acorn_hook_the_stalk_from_the_dark": ["Fished a light out of the dark. Nothing bit.", "Reeled it in. Gentle. Like a very bright trout."], "magic_acorn_stand_guard_over_the_beacon": ["Nothing is stealing the light. Not on my watch.", "Guarding a nut at midnight. Career highlight."], "magic_acorn_hold_a_wing_over_it_in_the_rain": ["Umbrella duty. Acorn gets dry. I do not.", "Rain hisses off the glow. I hold the wing. Fair."]},
