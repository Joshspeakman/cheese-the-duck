 "lines": {"scarf_red_tug_the_knot_snug": ["Snug. Slightly throttled, mostly fine.", "Knot back up. Dignity pending."], "scarf_red_scrub_the_wraps_clean": ["Scrubbed a scarf while wearing it. Gymnastic.", "Red again. The grime can sue."], "scarf_red_lay_it_out_to_dry": ["Spread out like a duck at a spa. Wool, I mean.", "Drip all you like. I'm not wearing a swamp."], "scarf_red_wrap_an_extra_turn": ["Third lap round the neck. Sheep did the work, I take the credit.", "Wrapped like a parcel. Return to sender, no."], "scarf_red_flip_a_tail_over_the_shoulder": ["Over the shoulder. Looks expensive now.", "Dashing. Slightly lopsided. Dashing."], "scarf_red_cross_the_tails_into_a_bow": ["A bow. Somebody mistook me for a present.", "Tied it myself. Do not ask how."], "scarf_red_snap_at_the_swinging_fringe": ["Almost. It's quick, this fringe.", "It was behind me the whole time."], "scarf_red_pull_against_his_own_fringe": ["Won. Against myself. Humbling.", "Fringe fought dirty. It's a very good scarf."], "scarf_red_shuffle_off_as_somebody_old": ["Back in my day, scarves were longer.", "Nobody can prove that bonnet is not just my head."], "scarf_red_count_the_ribs_with_his_bill": ["Lots of ribs. No bones.", "Four. Or forty. Lost count."], "scarf_red_hold_both_tail_ends_together": ["The left one is longer. Always has been.", "Uneven. Like my legs on a bad day."], "scarf_red_sink_into_the_wraps_for_a_nap": ["Wool pillow. Worn by me.", "Out cold. Warm at the front."], "scarf_red_wait_with_a_foot_tapping": ["Nobody. Fine. The knot and I will wait.", "Still here. The wool is patient, I am not."], "scarf_red_plump_it_into_a_cushion": ["Best seat in the yard. Made of me.", "Cushion. Warm. Mine. Do not sit."], "scarf_red_brace_into_the_gale": ["Scarf is going to Narnia. I am staying.", "Wind: one. Neck: still attached."], "scarf_red_argue_with_the_knot": ["Knot: winning. Bill: sore.", "Argued with wool. Lost on points."], "scarf_red_tread_on_the_long_tail": ["Tripped on myself. Impressive.", "My scarf. My trap. My arse."], "scarf_red_chase_it_down_the_yard": ["Come back. I paid for you. Probably.", "The wind took it. I took it back."]},
