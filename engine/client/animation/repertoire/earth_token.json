 "lines": {"earth_token_sweep_the_kicked_up_grit_off_the_foot": ["Grit's gone. Nobody will know what I did down here.", "Swept it up. The earth will file a complaint."], "earth_token_press_a_foot_flat_and_feel_for_a_rumble": ["Nothing. Very still. Suspiciously earth-like.", "No rumble. Just me being heavy."], "earth_token_lift_the_token_and_feel_how_it_drags_him": ["It weighs like a mountain. In fairness, it is one.", "Lifted it. Spine filed a complaint."], "earth_token_gong_the_left_plate_to_hear_it_ring": ["Rang it. Stone doesn't ring. Metal's lying to me.", "BONG. Again. For the neighbours."], "earth_token_butt_a_slat_to_see_who_gives_first": ["Slat 2, head 0. Slat's got seniority.", "Gave first. A lump. Nobody tell the slat."], "earth_token_knock_on_the_slats_to_hear_if_they_are_stone": ["Wood. Wood. Wood. Disappointing consistency.", "Not stone. I'd have felt it in the beak."], "earth_token_lick_the_grit_to_find_out_what_it_is": ["Grit. Earth. Slightly chicken. Don't ask.", "Tastes like the floor. It is the floor."], "earth_token_nap_curled_up_like_a_boulder_against_the_foot": ["Boulder mode. Do not kick. Do not weigh.", "Asleep. Rolled slightly. Lichen pending."], "earth_token_sulk_with_a_heavy_back_to_the_world": ["Heavy mood. Dense. Very earthy.", "The ground gets me. It's a low bar."], "earth_token_sweep_the_blown_leaves_off_the_foot": ["Leaves off. Wind will bring them back. We have a thing.", "Swept. The wind took that personally."], "earth_token_present_the_token_to_the_empty_garden": ["Behold the ground. You are standing on it.", "Earth, ladies and geese. Sorry. Ducks."], "earth_token_argue_with_the_stone_about_who_is_older": ["I'm older than the rock. In spirit. Spiritually, I'm a boulder.", "Stone never answers. Maybe that is the win."], "earth_token_shout_into_the_pane_for_an_echo": ["No echo. Everyone's out. I checked.", "Hello. Hello. Hel. The mountain's busy."], "earth_token_sink_a_foot_into_the_grit_and_rock_it_free": ["Ankle-deep in my own mess. Metaphorically also.", "Out. With a noise. Do not mention the noise."], "earth_token_scoop_a_heap_of_grit_together": ["Met in the middle. Heap fully built. Neither of us won.", "Two ducks, one mound. Mine has the better side."], "earth_token_shoulder_the_foot_of_the_case_side_by_side": ["Two of us. One case. The case isn't even sweating.", "It moved a bit. That was the friend leaving."], "earth_token_huff_a_cloud_onto_the_pane_and_peck_a_mountain_in_it": ["Mountain: wonky. Cloud: fine. Gone by tea.", "Drew a mountain in my own breath. Peak artist."]},
