 "lines": {"toy_seesaw_scrub_the_base_bar": ["Scrubbed the bar. It's cleaner. It's still a bar.", "Bill's brown now. Moving on."], "toy_seesaw_scoop_snow_off_the_feet": ["Dug the legs out. The seesaw's grateful, in a wooden way.", "Snow's gone. It'll hold a grudge, same as me."], "toy_seesaw_brace_at_the_leg_in_the_gale": ["Gust tried the frame. I tried the gust. Frame won, narrowly.", "Leaves in my face. I'm taking it personally."], "toy_seesaw_take_turns_pressing_the_ends": ["One end goes down, the other goes up. Physics, apparently.", "Took turns. Lost count. Won anyway."], "toy_seesaw_nudge_a_friend_along_the_bar": ["Shoved them off their foot. They shoved back. Civilised.", "We traded ends. Neither of us won."], "toy_seesaw_chase_a_friend_round_the_post": ["Chased a friend round a post. The post stayed neutral.", "Caught them round the pole. Let go. Dignity first."], "toy_seesaw_lick_the_leg": ["Paint, splinters, a bit of other duck. Zero stars.", "Tastes like waiting for someone."], "toy_seesaw_throw_a_shoulder_at_the_frame": ["Didn't scoot. It's bolted down. Admirable. Annoying.", "Shoulder hurts. Frame doesn't even know."], "toy_seesaw_sulk_at_the_far_leg": ["Two seats, no one. The plank has taught me about life.", "Even the seesaw has someone on the other end. Smug thing."], "toy_seesaw_hug_the_leg": ["Hugged a leg. It didn't hug back. Wood's like that.", "Don't tell the plank. It's the sensitive one."], "toy_seesaw_chant_see_saw": ["See. Saw. See. Saw. It's all I know and I'm proud of it.", "I did the chant. The seesaw stayed level out of spite."], "toy_seesaw_hail_the_far_seat": ["Called the far seat. It has terrible manners.", "I'd take a seat. Then I'd have to get up."], "toy_seesaw_sing_see_saw_in_rounds": ["See, saw, see, saw. We're not good. We're loud.", "Sang it in rounds. The legs hummed along."], "toy_seesaw_lifted_it_and_got_bonked": ["It was up. I admired it. It came down. We're not speaking.", "Bonked on my own good idea."], "toy_seesaw_stubbed_a_toe_on_the_bar": ["It twanged. I swore. We both vibrated.", "Toe hurts. Bar's fine. Typical."], "toy_seesaw_knocked_his_head_standing_up": ["Plank 1, skull 0. Rematch denied.", "That's a hard seat for a soft head."]},
