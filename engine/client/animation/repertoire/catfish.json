 "lines": {"catfish_skim_the_leaf_mat": ["Leaves out. Cat did not even look up.", "Heaped the lot by the tuft. Compost, if it asks."], "catfish_scrape_the_belly_stone_green": ["Slime off. The cat can rub on bare rock like an adult.", "Scraped a rock for a fish. Tomorrow I scrape for me."], "catfish_unwind_a_weed_thread_from_a_barbel": ["Off. It sat still for the whole thing. Brave, or asleep.", "Whisker one, whisker two. Cat is spotless now, weirdly."], "catfish_toss_pellets_over_the_deep_edge": ["Pellets down. Now we wait for the whiskers.", "Dinner is served at the bottom. Where cats keep their standards."], "catfish_hold_a_pellet_to_the_hungriest_cat": ["Whole pellet, no chewing. A cat that trusts the system.", "That mouth could take my bill off. It chose not to."], "catfish_draw_the_cat_along_the_floor_row": ["Followed me blind, the whole way. Lovely, trusting idiot.", "Led a cat by the wing. Nobody leads me."], "catfish_race_the_cat_along_the_bank": ["Lost, narrowly. It does not even use legs.", "Cat won by a barbel. I want a recount."], "catfish_blow_bubbles_down_to_it": ["It popped one with its face. Good form.", "Blew bubbles at a fish. This is what ducks are for."], "catfish_measure_the_whisker_span": ["Wider than my wings. It is mostly moustache.", "Spanned it twice. Still not a fair measure."], "catfish_peer_into_the_great_mouth": ["Big enough for my head. I did not test that.", "Looked in. Saw a lot of cat."], "catfish_listen_at_the_bottom_edge": ["Heard a cat think. Mostly about pellets.", "Stone says nothing. Cat says even less."], "catfish_bow_to_the_big_cat": ["Bowed. It blinked. We are even.", "Respect costs a neck muscle. Worth it."], "catfish_argue_the_moustache_rights": ["Mine is only two lines. It has a moustache and a mood.", "Lost the argument. Kept the grudge."], "catfish_sing_the_cat_a_night_song": ["It stayed for the chorus. Left before the bridge.", "Low notes only. The cat has standards, mostly bass."], "catfish_hop_back_from_the_snapping_jaws": ["It mistook my face for a snack. Fair, mostly.", "Jaws. In a pond. Eight inches from my bill."], "catfish_compare_whisker_counts_with_a_friend": ["Eight. Argued down from eleven. Whiskers do not hold still.", "Two ducks counting a fish. Fish keeps the number."]},
