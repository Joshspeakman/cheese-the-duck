 "lines": {"wooden_cottage_scrub_the_timber_planks": ["Timber was grey. Now timber is grey and damp.", "Scrubbed the planks. Wing has opinions."], "wooden_cottage_sweep_the_leaves_off_the_step": ["Leaves in the yard. Yard did not ask.", "Swept the step. The wind is already reconsidering."], "wooden_cottage_nail_a_brace_back": ["Brace holds. Cottage stands. I lie down.", "Hammered with my chest. Chest has regrets."], "wooden_cottage_nip_the_wilted_heads": ["Wilted heads off. The cottage looks brighter and slightly smug.", "Neater now. Flowers can hold a grudge."], "wooden_cottage_knock_at_the_cottage_door": ["Knocked. Doormat unmoved. Doormat is not here.", "Polite knock, polite wait, polite sulk."], "wooden_cottage_peer_into_the_mailbox": ["Mailbox: empty. Typical. I never get bread by post.", "Looked in. It looked emptier."], "wooden_cottage_sniff_the_flower_box": ["Smells of spring and bad decisions.", "Sneezed. Three blooms retired."], "wooden_cottage_shout_up_the_chimney": ["Asked the chimney nicely. Chimney is cold on principle.", "Smoke is a polite word for no."], "wooden_cottage_drum_the_planks": ["Timber has a good beat. Plates keep time.", "Planks on the off-beat. Cottage taps its toe."], "wooden_cottage_taste_a_petal": ["Petal. Perfume. Disappointment.", "Tastes like a bad idea with a ribbon."], "wooden_cottage_lean_on_the_warm_planks": ["Warm planks. Warm duck. Warm nothing else.", "Sun in the timber. Peace in the beak."], "wooden_cottage_nap_on_the_mailbox": ["Mailbox nap. Post arrives, I stay.", "Slept on the lid. Dreamt of parcels."], "wooden_cottage_sulk_by_the_flower_box": ["The flowers can hear me not talking.", "Petals aren't impressed. Neither am I."], "wooden_cottage_chip_frost_off_the_sill": ["Sill de-iced. Curtain twitched. I was seen.", "Chip, chip, drip. Good morning, window."], "wooden_cottage_kick_the_drift_off_the_step": ["Step cleared. Toes iced. Even.", "Snow went flying. Duck stayed grounded."], "wooden_cottage_shelter_beside_the_chest": ["Rain rattles the shingles. I rattle nothing.", "Dry patch the size of a duck. Reserved."], "wooden_cottage_walk_into_the_clear_pane": ["Glass, with a curtain on it. Cheating.", "Pane stayed. Dignity left."], "wooden_cottage_slip_on_the_wet_step": ["Wet step, dry humour. Mostly dry.", "Down went the duck. Up went the sky."], "wooden_cottage_kick_the_flower_box": ["Box unmoved. Toe now a philosophy.", "Kicked the flowers' home. They noticed."], "wooden_cottage_show_off_the_cottage": ["Quaint. Flowery. Post box included.", "Two windows, one duck, no offers."], "wooden_cottage_argue_with_the_mailbox": ["Mailbox refuses to explain. Mailbox is a coward.", "Won the argument. Latch has not conceded."]},
