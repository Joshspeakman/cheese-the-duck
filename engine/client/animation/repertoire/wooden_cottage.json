 "lines": {"wooden_cottage_scrub_the_left_boards": ["Boards scrubbed. Cottage looks smug. Cottage always has.", "Streaks gone. Wing ruined. Pride restored."], "wooden_cottage_hammer_a_lifted_stud": ["Stud down. Cottage secure. Duck exhausted.", "Hammered it with my face. Nobody saw. Good."], "wooden_cottage_comb_the_right_vine": ["Vine combed. Vine unrepentant. Vine will sprawl again.", "Neat as a duck can make a plant."], "wooden_cottage_knock_at_the_low_rail": ["Cottage did not answer. Probably writing a will.", "Knocked three times. Politely. Nobody cares."], "wooden_cottage_shout_up_at_the_left_window": ["Window stayed shut. Curtain twitched. Possibly the wind.", "Called up. Heard crickets. In daytime. Bold."], "wooden_cottage_sniff_the_blossoms": ["Smells like a garden. Garden has opinions about my face.", "Sneezed on a daisy. It will recover. Probably."], "wooden_cottage_shoulder_the_oak_door": ["Door held. House held. Even the vines held. Ganging up.", "Shoulder gone. Pride gone. Door fine."], "wooden_cottage_vanish_into_the_vines": ["Ambush. Vine kept my secret. Vine kept my feathers too.", "Roared. Nothing flinched. Plants are cowards."], "wooden_cottage_scratch_at_the_right_planter": ["Soil out. Flowers tilt. Landscaping is destruction with intent.", "Dug a crater. Planter reports a draught."], "wooden_cottage_rock_the_little_tub": ["Tub rocked. Tub rolled its eyes. Tubs have no eyes.", "Clunk. Something inside. Or the tub itself. Concerning."], "wooden_cottage_tap_the_right_boards": ["Hollow at the top. Solid at the bottom. Like most cottages.", "Tapped the whole wall. It tapped nothing back."], "wooden_cottage_measure_up_to_the_sill": ["Not quite. A bun on the sill would help me.", "Sill 1, duck 0. Measured. Seething."], "wooden_cottage_nibble_a_vine_leaf": ["Bitter. Leafy. Cottage taste profile: lawn.", "Nibbled a leaf. The vine took it personally."], "wooden_cottage_lean_against_the_warm_planks": ["Warm planks. Every cottage should come with them.", "Leaned. Planks held. The only reliable relationship."], "wooden_cottage_sit_on_the_cottage_step": ["Thoughts elsewhere. Body on a step. Excellent split.", "Sat. A bee passed. We did not speak."], "wooden_cottage_sulk_at_the_left_vines": ["Vines are on the house's side. I can tell.", "Sulk intensity: maximum. Audience: botanical."], "wooden_cottage_kick_the_snow_off_the_lip": ["Snow gone. Step bare. Feet numb. Cottage grateful. Probably.", "Kicked until the snow gave up. Toes gave up first."], "wooden_cottage_rake_the_leaf_litter": ["Leaves in a pile. Pile in the wind. Sigh.", "Raked. Redone by wind in nine seconds. Sure."], "wooden_cottage_cool_off_beside_the_planter": ["Hot. Bothered. Feathered. Planter is a mercy.", "Panting at a planter. Nobody saw. Everyone did."], "wooden_cottage_skid_off_the_wet_step": ["Wet step. Dry wit. Wet duck.", "Feet had a plan. Floor had a better one."], "wooden_cottage_walk_into_the_vine_tangle": ["Vines won. I left with vines. Best possible loss.", "Never trust a wall that wriggles."], "wooden_cottage_wing_tangled_in_the_vines": ["Vine took my wing hostage. Negotiated in flapping.", "Tangled. Untangled. Still tangled, spiritually."], "wooden_cottage_crack_the_frame_with_a_peck": ["Paint came off. Board sulked. I regret nothing.", "Frame cracked. Window will be sensible about it."], "wooden_cottage_stub_a_toe_on_the_tub": ["Tub is fine. I am a limp with feathers.", "Toe met tub. Tub won. Toe wants a lawyer."], "wooden_cottage_pose_between_the_planters": ["Landowner. Hobbit-adjacent. Do not touch the flowers.", "Flowers left, flowers right, ego centre."], "wooden_cottage_present_the_cottage": ["Charming. Compact. Ducks only. Viewings by appointment.", "Original features include me. Do not scratch."], "wooden_cottage_argue_with_the_tub": ["Tub refuses to engage. Classic tub.", "Won. Tub keeps rim-high. Moral victory."]},
