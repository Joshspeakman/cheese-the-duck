 "lines": {"greenhouse_wipe_the_mist_off": ["Wiped a peephole. Mist filed a complaint.", "Clear patch. Duck-shaped smear. Art."], "greenhouse_polish_the_glazing_rail": ["Rail shines. I can see my own bill in it. Gorgeous.", "Polished with my chest. Chest is now the cleanest part."], "greenhouse_sweep_up_the_petals": ["Petals in a heap. Pretty heap. Still a heap.", "Swept up the confetti the flowers threw."], "greenhouse_mend_a_glazing_bar": ["Bar clicked in. Glasshouse stands. Glasshouse stares.", "Fixed it with my whole weight. Technique."], "greenhouse_sniff_the_blossoms": ["Smells green. Smells posh. Smells of sneezing.", "Petals everywhere. My fault. Nose's fault."], "greenhouse_knock_on_a_pane": ["Knocked on glass. Glass said nothing, clearly.", "Only plants home. Plants are snobs."], "greenhouse_drum_the_pots": ["Pots have rhythm. Plants have none.", "Clay on the downbeat. Glass on the chorus."], "greenhouse_taste_a_dropped_petal": ["Tastes like perfume. Tastes like a bad idea.", "Petal. Soap. Lawn. In that order."], "greenhouse_nap_on_the_bench": ["Bench nap. Petals for a pillow. Posh.", "Slept among the leftovers. Woke up scented."], "greenhouse_warm_up_on_the_sunny_glass": ["Glass hot as a pan. I am a very happy egg.", "Steam rising off my back. Bliss, with side effects."], "greenhouse_chip_frost_off_the_pane": ["Frost off the glass. Now the plants can see me.", "Chipped a window. Window is thrilled."], "greenhouse_cool_off_on_the_bench": ["Greenhouse in summer is a kettle with windows.", "Fanned myself. Plants are fine. I am a ham."], "greenhouse_shelter_among_the_planters": ["Rain on glass. Duck in flowers. Cinema.", "Roof leaks sound. I leak nothing. Winning."], "greenhouse_walk_into_the_clear_glass": ["Glass. Invisible. Bastard.", "Greenhouse is mostly door-shaped lies."], "greenhouse_slip_on_the_wet_step": ["Step was a lake. Dignity was a duck.", "Feet left first. Rest followed, sulking."], "greenhouse_snap_a_stem_with_a_wing": ["Snapped one. Blamed the stem. The stem knows.", "Flower down. Wing innocent. Alibi pending."], "greenhouse_kick_the_pot_by_accident": ["Pot unharmed. Foot is a rumour now.", "Kicked clay. Clay won. Standard."], "greenhouse_peck_the_glass_too_hard": ["Cracked it. Slightly. Quietly. Moving on.", "Hairline crack. Glass will outlive the embarrassment."], "greenhouse_show_off_the_glass_house": ["Cosy. Bright. Slightly damp. Price on request.", "Full of plants. No ducks. Gap in the market."], "greenhouse_hook_a_flower_down_with_a_twig": ["Got the stem. Got the flower. Got a petal shower.", "Twig did the reaching. Nose did the bad decisions."], "greenhouse_wipe_a_smiley_in_the_mist": ["Drew a face. It looks like the landlord.", "Smiley on the glass. The plants look unconvinced."]},
