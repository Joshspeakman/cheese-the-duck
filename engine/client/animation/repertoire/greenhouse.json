 "lines": {"greenhouse_scrub_lower_panes": ["Panes scrubbed. Now the flowers can see how little I care.", "Wiped it all. Spotless. Suspicious."], "greenhouse_seat_a_glazing_bar": ["Bar seated. Glass saved. Zero applause. Typical.", "Pushed it in with my face. Tradition."], "greenhouse_line_up_the_pots": ["Pots straight. Plants unimpressed. Pots grateful. Allegedly.", "Lined them up. Soldiers of soil."], "greenhouse_rap_the_door_frame": ["Tea not forthcoming. Plants rarely host.", "Knocked on a glass house. Brave. Pointless."], "greenhouse_tap_glass_at_flower": ["Flower ignored me. I respect the craft.", "Tapped twice. Bloom stayed rude and upright."], "greenhouse_test_the_latch": ["Latch works. Door is not open. Tragic combination.", "Clicked it twice. Second one was spite."], "greenhouse_tell_the_flowers_off": ["Told them everything. Not one asked a question.", "Flowers listen well. Mostly because they cannot leave."], "greenhouse_flatten_at_right_jamb": ["Ambushed a flower. It lost. Nobody else saw.", "Jumped out. The jamb did not jump. Weird."], "greenhouse_dig_in_the_right_pot": ["Dug a hole. Sprout seems fine. Relocated my guilt.", "Soil in my bill. Plan unclear. Mood excellent."], "greenhouse_listen_at_the_glass": ["Heard nothing. Plants are keeping it classified.", "Leaf rustle, maybe. Might be rude."], "greenhouse_lick_the_glass": ["Glass. Confirmed. Tastes like a mistake.", "Licked it. Now I know. Nobody asked."], "greenhouse_measure_up_to_the_ledge": ["Ledge comes to my chest. Pleased. Smug.", "Not tall. Not short. A very precise duck."], "greenhouse_lean_on_sunny_glass": ["Warm glass. Warm duck. Slow plan.", "Sunbathing against a window. Ten out of ten, no notes."], "greenhouse_sit_on_the_right_ledge": ["Flowers grew. Possibly. I blinked.", "Sat. Watched. Nothing happened, slowly."], "greenhouse_sulk_at_the_pots": ["The flowers know what they did. So do I.", "Sulking next to plants. They never apologise."], "greenhouse_wipe_the_fogged_pane": ["Fog gone. Flowers still rude. Visibility is overrated.", "Squeaked the pane clear. Squeak was the best bit."], "greenhouse_write_in_the_fog": ["Face drawn. Looks like me. Rude of it.", "Fog art. Gone by lunch. Like all my masterpieces."], "greenhouse_fan_himself_by_the_glass": ["Greenhouse. Greenhouse effect. Greenhouse duck.", "Too hot for feathers. Too stubborn for shade."], "greenhouse_slip_on_the_wet_step": ["Step is wet. Step is smug. I am horizontal.", "Left foot to the pub. Right foot to follow."], "greenhouse_walk_nose_first_into_glass": ["Glass is a trick. I demand a sign.", "Flower saw it. Flower said nothing. Flower snickered."], "greenhouse_peck_a_pane_too_hard": ["Pane cracked. Pane was asking for it. Probably.", "That was my own reflection. Hit it first."], "greenhouse_bill_wedged_in_ironwork": ["Gap grew a grip. Gap lets go. Gap smirks.", "Bill in, bill out. The ironwork won the middle."], "greenhouse_stub_his_toe_on_a_pot": ["Pot did nothing. Pot won anyway.", "Toe hurts. Pot is not sorry."], "greenhouse_pose_by_the_door": ["Botanist. Do not check the papers.", "Posed with plants. They stayed in character."], "greenhouse_present_the_glasshouse": ["Light, airy, no roof worries. One flaw: plants.", "Three panes, no offers. Market is brutal."], "greenhouse_argue_with_a_flower": ["Flower lost. Flower never moved. Counting it a win.", "It won on points. I won on volume."], "greenhouse_serenade_the_pots": ["Sang to the sprouts. They leaned away. Critics.", "Two pots, one voice. Standing ovation: absent."]},
