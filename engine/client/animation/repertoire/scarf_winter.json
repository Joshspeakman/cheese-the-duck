 "lines": {"scarf_winter_pick_the_pills_off": ["Bobbles gone. The scarf looks hurt.", "Forty pills picked. A duck has hobbies."], "scarf_winter_press_the_water_out_against_his_belly": ["Pressed a sponge to my stomach. Great morning.", "It weighs more than I do. Allegedly."], "scarf_winter_wind_the_loops_up_to_the_ears": ["Wound up. Ready for any season but this one.", "I am a duck-shaped bun of wool."], "scarf_winter_roll_it_up_into_a_bundle": ["A bundle. Now it travels. Very practical.", "Rolled it up. Unrolled it. Productive afternoon."], "scarf_winter_spin_so_the_heavy_ends_swing_wide": ["The ends have more momentum than I do.", "Spun. Wrapped. Mildly bound."], "scarf_winter_belly_slide_along_the_snow": ["Toboggan. Scarf. Terrible plan, ten stars.", "Slid until the snow ran out. Then some more."], "scarf_winter_totter_about_as_a_ghost": ["Boo. Nobody scared. Boo again.", "Very frightening. For a nap."], "scarf_winter_tap_the_frozen_cable": ["Rings like a bell. A very small bell.", "Frozen solid. Like my enthusiasm on Mondays."], "scarf_winter_sniff_the_damp_wool": ["Wet sheep. A whole flock, in fact.", "Smells like a farm. I was never at the farm."], "scarf_winter_hang_his_weight_on_one_end": ["Holds. Tough knit. Unlike me.", "Hung off it like a bat. A heavy bat."], "scarf_winter_pinch_the_wool_to_see_how_thick": ["Two fingers thick. I have no fingers.", "Thick. Like a cheese rind but kind."], "scarf_winter_sulk_with_his_chin_in_the_wraps": ["Not in the mood. The scarf agrees. It's heavy with it.", "You can all go and stuff a sock."], "scarf_winter_drape_an_end_over_a_cold_foot": ["Foot warm. Other foot offended.", "A scarf is also a sock, if you shut up about it."], "scarf_winter_wring_the_meltwater_from_the_fringe": ["Wrung. A whole puddle came out of a tassel.", "Freezing meltwater down my leg. Splendid."], "scarf_winter_argue_with_the_wraps": ["Stay down. I mean it. It doesn't.", "Wool: 1. Neck: 0. Dignity: gone."], "scarf_winter_hum_a_carol_into_the_collar": ["Deck the halls. Mumble. Mumble. Wool.", "A choir of one, muffled."], "scarf_winter_chin_jammed_in_the_high_collar": ["Can't turn my head. Hello, side of a hedge.", "Stuck in a scarf. Smothered by love and wool."], "scarf_winter_whacked_in_the_face_by_his_own_end": ["Hit myself with a scarf. Weapon: knitted.", "Assaulted by wool. Crime scene: me."]},
